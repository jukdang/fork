<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO" monitorInterval="30">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %c{1}:%L - %m%n</Property>
        <!-- 경로 프로퍼티 추가 -->
<!--         <Property name="LOG_DIR">C:\\Users\\\\theimc\\Desktop\\eclipse\\logs2</Property> -->
        <Property name="LOG_DIR">/home/gj_dev/web/logs</Property>
    </Properties>
    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>
        
        <!-- 운영 환경 로그 파일 경로 -->
        <RollingFile name="File" fileName="${LOG_DIR}/application_sys.log" 
                     filePattern="${LOG_DIR}/application_sys.log.%d{yyyy-MM-dd}">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
            	<OnStartupTriggeringPolicy/>
            	<SizeBasedTriggeringPolicy size="10MB"/>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="org.springframework" level="INFO" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="File"/>
        </Logger>
        
        <Logger name="egovframework.geri.sysadm.dao.SysAdmDao.insertRdsData" level="ERROR" additivity="false">
			<AppenderRef ref="File"/>
        </Logger>
        <!-- Root Logger -->
        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
