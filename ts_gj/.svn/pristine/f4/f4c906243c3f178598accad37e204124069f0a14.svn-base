<!DOCTYPE html>
<html lang="ko" xmlns="http://www.w3.org/1999/xhtml" xmlns:th="https://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/thymeleaf-extras-springsecurity5">
<head>
	<th:block th:replace="/layout/head :: head-admin"></th:block>
	<script th:src="@{/js/egovframework/paging.js}"></script>
</head>
<body>
	<!-- wrap : S -->
    <div class="wrap" id="wrap">
    
        <!-- 상단 헤더 -->
        <div th:replace="/layout/header :: left-menu-admin"></div>
	        
	    <!-- container : S -->
		<div id="container" class="scrollBar">
		 	<!-- 메인 컨텐츠 -->
		    <div class="contents">
		        <div class="wrapper">
	                <div class="tit_wrap">
	                	<h1 th:text="${pageInfo.pageTitle}"></h1>
	                </div>
	                <div class="filter_section">
	                	<div class="wh_box filter_area">
	                		<div class="filter_wrap">
								<div class="top_date">
								    <label>기간</label>
									<input type="date" id="startDt">
							        <em>~</em>
							        <input type="date" id="endDt">
								</div>
								<script>
							        // 오늘 날짜
							        const today = dayjs();
							        // 7일 후 날짜 계산
							        const sevenDaysLater = today.add(-7, 'day');
							        
							        // 기본값 설정 (YYYY-MM-DD 형식)
							        document.getElementById('startDt').value = sevenDaysLater.format('YYYY-MM-DD');
							        document.getElementById('endDt').value = today.format('YYYY-MM-DD');
							        document.getElementById('endDt').max = today.format('YYYY-MM-DD');
							    </script>
								<div class="top_select">
									<div th:replace="/common/ownrSelect :: mngr-select"></div>
									<div>
										<input type="text" id="oprtrNm" placeholder="운전원명 입력">
									</div>
                                    <button type="button" class="btn mid blue" onclick="getOprtrDataList();">검색</button>
	                            </div>
							</div>
	                	</div>
	                </div>
	                <section class="tbl_section">
	                	<div class="col02">
		                	<div class="wh_box">
		                		<div class="stit_wrap type02">
				                	<h2>운전원 정보</h2>
				                	<em>총 <b id="totalCnt"></b>건</em>
				                </div>
				                <div class="tbl_box scrollBar">
			                        <table class="tbl02" style="min-width: 100%;">
			                            <thead>
			                                <tr>
			                                    <th class="w10p">No</th>
			                                    <th class="w20p">운수회사</th>
			                                    <th class="w20p">운전원 아이디</th>
			                                    <th class="w26p">운전원명</th>
			                                    <th class="w20p">RFID 아이디</th>
			                                </tr>
			                            </thead>
			                            <tbody id="oprtrDataArea">
			                            	<tr>
			                            		<td colspan="5">조회결과가 없습니다.</td>
			                            	</tr>
			                            </tbody>
			                        </table>
			                    </div>
			                    <div class="paging" id="oprtrPaging">
			    				</div>
		                	</div>
		                	<div class="wh_box">
		                		<div class="stit_wrap type02">
		                			<h2 id="oprtrTagTitle">운행기록 정보</h2>
		                			<div class="stit_right">
			                			<select name="orderSelect" id="orderSelect">
									        <option value="desc">최신순</option>
									        <option value="asc">오래된순</option>
									    </select>
<!-- 			                			<button type="button" class="btn mid scolor" onclick="fn_download();">다운로드</button> -->
		                			</div>
		                		</div>
		                		<div class="tbl_box scrollBar">
			                        <table class="tbl02 none_hover" style="min-width: 100%;">
			                            <thead>
			                                <tr>
			                                    <th class="w10p">No</th>
			                                    <th class="">태그 일시</th>
			                                </tr>
			                            </thead>
			                            <tbody id="tagDataArea">
			                            	<!-- 첫화면 -->
			                            	<tr>
			                            		<td colspan="2">기록 내역을 선택해주세요.</td>
			                            	</tr>
			                            </tbody>
			                        </table>
			                    </div>
			                    <input type="hidden" id="currentOprtr" value="">
			                    <div class="paging" id="tagPaging">
			    				</div>
		                	</div>
	                	</div>
	                </section>
	            </div>
	        </div>
	        <!-- 푸터 -->
		    <th:block th:replace="/layout/footer :: footer-simple"></th:block>
	    
	    <!-- <p>유저 아이디: <span sec:authentication="name"></span></p> -->
	    </div>
		<!-- container : E -->
	</div>
	<!-- wrap : E -->
   	<script>
	$(document).ready(function() {
		getOprtrDataList();
		$("#searchBtn").on("click", function() {
			getOprtrDataList();
		});
		
		$('#oprtrDataArea').on('click', 'tr', function() {
	        // 클릭된 li의 data-vhcl-sn 값 가져오기
	        var rfidNo = $(this).data('rfid-no');
	        var oprtrNm = $(this).data('oprtr-nm');
	        $("#currentOprtr").val(rfidNo);
	        $("#oprtrTagTitle").text(oprtrNm + ' 운행기록');
	        getRfidTagList(1, rfidNo);
	    });
		
	    $("#orderSelect").on("change", function() {
	        getRfidTagList(1, $("#currentOprtr").val());
	    });
	});
	
	function getOprtrDataList(pageIndex = 1){
		var resetHtml;
		resetHtml += `<tr>
			<td colspan="2">조회결과가 없습니다.</td>
		</tr>`;
		$("#tagDataArea").html(resetHtml);
// 		setPagination('tagPaging', 'getRfidTagList', null);
		
	    var ownrNm = $("#ownrSelect").val();
	    var oprtrNm = $("#oprtrNm").val();
	    var startDt = $("#startDt").val();
	    var endDt = $("#endDt").val();
	    customFetch({
	        url: '/mngr/getRfidTagOperatorList',
	        method: 'POST',
	        params: {
	        	ownrNm : ownrNm,
	        	pageIndex : pageIndex,
	        	oprtrNm : oprtrNm,
	        	startDt : startDt,
	        	endDt : endDt
	        },
	        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	        onSuccess: (response) => {
	        	console.log(response)
	            var html = '';
	            if (response && response.data && response.data.list) {
		            var list = response.data.list;
		            const paginationInfo = response.data.paginationInfo
		            $("#totalCnt").text(paginationInfo.totalRecordCount)
		            if(list.length > 0){
		            	list.forEach(function(item, index) {
			            	const rowNumber = (paginationInfo.totalRecordCount || 0) - 
	                        ((paginationInfo.currentPageNo - 1) * (paginationInfo.recordCountPerPage || 10)) - index;
			            	html += `<tr data-rfid-no="${item.rfidNo}" data-oprtr-nm="${item.oprtrNm}" tabindex="0">
										<td>${rowNumber}</td>
										<td>${item.ownrNm}</td>
										<td>${item.oprtrId}</td>
										<td>${item.oprtrNm}</td>
										<td>${item.rfidNo}</td>
									</tr>`;
			            	if (typeof setPagination === 'function') {
		                        setPagination('oprtrPaging', 'getOprtrDataList', response.data.paginationInfo);
		                    }
		            	});
						$("#oprtrDataArea").html(html);
		            }else{
		            	html += `<tr>
									<td colspan="5">조회결과가 없습니다.</td>
								</tr>`;
		            	$("#oprtrDataArea").html(html);
		            	setPagination('oprtrPaging', 'getOprtrDataList', response.data.paginationInfo);
		            }
	            }
	        },
	        onError: (error) => console.error('에러:', error)
	    });
	}
	
	function getRfidTagList(pageIndex = 1, rfidNo){
		var startDt = $("#startDt").val();
	    var endDt = $("#endDt").val();
	    var order = $("#orderSelect").val();
	    
	    customFetch({
	        url: '/mngr/getRfidTagList',
	        method: 'POST',
	        params: {
	        	pageIndex : pageIndex,
	        	searchType : 'list',
	        	rfidNo : rfidNo,
	        	startDt : startDt,
	        	endDt : endDt,
	        	order : order
	        },
	        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	        onSuccess: (response) => {
	        	
	            var html = '';
	            if (response && response.data && response.data.list) {
		            var list = response.data.list;
		            const paginationInfo = response.data.paginationInfo
		            		console.log(paginationInfo)
		            if(list.length > 0){
		            	list.forEach(function(item, index) {
			            	const rowNumber = (paginationInfo.totalRecordCount || 0) - 
	                        ((paginationInfo.currentPageNo - 1) * (paginationInfo.recordCountPerPage || 10)) - index;
			            	const formattedDate = dayjs(item.tagDt).format('YYYY-MM-DD HH:mm:ss');
			            	html += `<tr data-oprtr-id="${item.oprtrId}">
										<td>${rowNumber}</td>
										<td>${formattedDate}</td>
									</tr>`;
			            	if (typeof setPagination === 'function') {
		                        setPagination('tagPaging', 'getRfidTagList', response.data.paginationInfo);
		                    }
		            	});
						$("#tagDataArea").html(html);
		            }else{
		            	html += `<tr>
									<td colspan="2">조회결과가 없습니다.</td>
								</tr>`;
		            	$("#tagDataArea").html(html);
		            	setPagination('tagPaging', 'getRfidTagList', response.data.paginationInfo);
		            }
	            }
	        },
	        onError: (error) => console.error('에러:', error)
	    });
	}
	
	function fn_download() {
// 		alert('aset')
		var startDt = $("#startDt").val();
	    var endDt = $("#endDt").val();
	    var order = $("#orderSelect").val();
	    var rfidNo = $("#currentOprtr").val();
	    try {
	        customFetch({
	            url: '/mngr/rfidTagDownload',
	            method: 'POST',
	            params: {
		        	searchType : 'download',
		        	rfidNo : rfidNo,
		        	startDt : startDt,
		        	endDt : endDt,
		        	order : order
		        },
	            responseType: 'blob',
	            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	            onSuccess: (blob) => {
	                // 이제 blob을 바로 사용 가능
	                const url = window.URL.createObjectURL(blob);
	                const a = document.createElement('a');
	                a.style.display = 'none';
	                a.href = url;
	                
	                const now = new Date();
	                const dateStr = now.getFullYear() + 
	                               String(now.getMonth() + 1).padStart(2, '0') + 
	                               String(now.getDate()).padStart(2, '0') + '_' +
	                               String(now.getHours()).padStart(2, '0') + 
	                               String(now.getMinutes()).padStart(2, '0') + 
	                               String(now.getSeconds()).padStart(2, '0');
	                
	                a.download = `태그정보_${dateStr}.xlsx`;
	                
	                document.body.appendChild(a);
	                a.click();
	                window.URL.revokeObjectURL(url);
	                document.body.removeChild(a);
	            },
	            onError: (error) => {
	                console.error('다운로드 오류:', error);
	            }
	        });
	    } catch (error) {
	        console.error('다운로드 오류:', error);
	    }
	}
	</script>  
</body>
</html>