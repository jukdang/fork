<!DOCTYPE html>
<html lang="ko" xmlns="http://www.w3.org/1999/xhtml" xmlns:th="https://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/thymeleaf-extras-springsecurity5">
<head>
	<th:block th:replace="/layout/head :: head-admin"></th:block>
	<script th:src="@{/js/egovframework/paging.js}"></script>
	<script th:src="@{/js/egovframework/customChart.js}"></script>
</head>
<body>
	<!-- wrap : S -->
    <div class="wrap" id="wrap">
    
        <!-- 상단 헤더 -->
        <div th:replace="/layout/header :: left-menu-admin"></div>
	        
	    <!-- container : S -->
		<div id="container" class="scrollBar">
	        <div class="contents board">
		        <div class="wrapper">
		            <div class="tit_wrap">
		                <h1 th:text="${pageInfo.pageTitle}"></h1>
		            </div>
		            
		            <div class="filter_section">
		                <div class="wh_box filter_area">
	                		<div class="filter_wrap">
								<div class="top_date">
								    <label>기간</label>
									<input type="date" id="startDt">
							        <em>~</em>
							        <input type="date" id="endDt">
								</div>
								<script>
							        // 오늘 날짜
							        const today = dayjs();
							        // 7일 후 날짜 계산
							        const sevenDaysLater = today.add(-7, 'day');
							        
							        // 기본값 설정 (YYYY-MM-DD 형식)
							        document.getElementById('startDt').value = sevenDaysLater.format('YYYY-MM-DD');
							        document.getElementById('endDt').value = today.format('YYYY-MM-DD');
							        document.getElementById('endDt').max = today.format('YYYY-MM-DD');
							    </script>
								<div class="top_select">
									<label>운수회사</label>
									<div th:replace="/common/ownrSelect :: mngr-select"></div>
                                    <button type="button" class="btn mid blue" id="searchBtn">검색</button>
	                            </div>
							</div>
	                	</div>
                	</div>
                	
                	<section>
                		<div class="col01">
		                	<div class="wh_box">
		           				<div class="stit_wrap type02"><h2>프롬프트 수</h2>
		           					<span class="ir_btn unit btn_date">
										<input type="radio" id="unit01" name="totalDatetype" value="date" checked><label class="on" id="unit03_label" tabindex="0" for="unit01">일</label>
										<input type="radio" id="unit02" name="totalDatetype" value="month"><label id="unit01_label" tabindex="0" for="unit02">월</label>
									</span>
		           				</div>
		           				<div class="graph_area" style="width: 100%; height: 300px;" id="chartDiv"></div>
		           			</div>
		           			
		           			<div class="wh_box">
			                    
			                    <div class="tit_wrap">
			                        <div class="stit_wrap type02">
			                			<h2>프롬프트 내역</h2>
			                			<em>총 <b id="totalCnt"></b>건</em>
			                		</div>
			                		<div>
			                        	<button type="button" class="btn mid scolor" onclick="fn_download();">다운로드</button>
			                        </div>
		                        </div>


			                    <div class="tbl_box scrollBar">
			                        <table class="tbl02 none_hover">
			                            <thead>
			                                <tr>
			                                    <th class="w10p">No</th>
			                                    <th class="w10p">소속</th>
			                                    <th class="w10p">ID</th>
			                                    <th class="">질문</th>
			                                    <th class="">답변</th>
			                                    <th class="w5p">평가</th>
			                                    <th class="w15p">일시</th>
			                                </tr>
			                            </thead>
			                            <tbody id="dataArea">
			                            </tbody>
			                        </table>
			                    </div>
			                    <!-- Paging -->
				                <div class="paging" id="paging">
					    		</div>

			                </div>
		                </div>
		            </section>

	                
			    		
			    
		        </div>
		    </div>
	        <!-- 푸터 -->
		    <th:block th:replace="/layout/footer :: footer-simple"></th:block>
	    </div>
		<!-- container : E -->
	</div>
	<!-- wrap : E -->
   	<script>
	$(document).ready(function() {
		getDataList(1);
		getLineDataList();
		$("#searchBtn").on("click", function() {
			getLineDataList();
			getDataList(1);
		});
		
		$('input[name="totalDatetype"]').on('click', function() {
		    const inputId = $(this).attr('id'); // input의 id 가져오기
		    const label = $('label[for="' + inputId + '"]'); // 연결된 label 선택

		    // 모든 label에서 'on' 제거
		    $('input[name="totalDatetype"]').each(function() {
		        const lbl = $('label[for="' + $(this).attr('id') + '"]');
		        lbl.removeClass('on');
		    });

		    // 클릭한 input의 label에 'on' 추가
		    label.addClass('on');

		    // input 체크
		    $(this).prop('checked', true);

		    // 기존 데이터 함수 호출
		    getLineDataList();
		});
	});
	
	function getLineDataList(){
		var dateType = $('input[name="totalDatetype"]:checked').val();
	    var ownrNm = $("#ownrSelect").val();
	    var startDt = $("#startDt").val();
	    var endDt = $("#endDt").val();
	    
	    customFetch({
	        url: '/mngr/getPromptStatusLineList',
	        method: 'POST',
	        params: {
	            ownrNm : ownrNm,
	            startDt : startDt,
	            endDt : endDt,
	            dateType : dateType
	        },
	        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	        onSuccess: (response) => {
	        	let list = response.data.list;
	        	console.log(list)
	        	const updatedList1 = list.map(item => ({
				    time: item.date,
				    "프롬프트 수": item.cnt
				}));
	        	makeLineChart("chartDiv", updatedList1, "time")
	        },
	        onError: (error) => console.error('에러:', error)
	    });
	}
	
	function getDataList(pageIndex = 1){
	    var ownrNm = $("#ownrSelect").val();
	    var startDt = $("#startDt").val();
	    var endDt = $("#endDt").val();
	    
	    customFetch({
	        url: '/mngr/getPromptStatusList',
	        method: 'POST',
	        params: {
	            pageIndex : pageIndex,
	            searchType: 'list',
	            ownrNm : ownrNm,
	            startDt : startDt,
	            endDt : endDt
	        },
	        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	        onSuccess: (response) => {
	            var html = '';
	            if (response && response.data && response.data.list) {
	                var list = response.data.list;
	                const paginationInfo = response.data.paginationInfo;
	                $("#totalCnt").text(paginationInfo.totalRecordCount);
	                if(list.length > 0){
	                    list.forEach(function(item, index) {
	                        const rowNumber = (paginationInfo.totalRecordCount || 0) -
	                            ((paginationInfo.currentPageNo - 1) * (paginationInfo.recordCountPerPage || 10)) - index;
	                        
	                        // dayjs를 사용해서 날짜 형식 변경
	                        const formattedDate = dayjs(item.regDt).format('YYYY-MM-DD HH:mm:ss');
	                        
	                        // ansCn을 JSON으로 파싱
	                        let parsedAnswer = null;
	                        let statusBadge = '';
	                        let answerCn = '';
	                        let evlCn = '';
                            parsedAnswer = JSON.parse(item.ansCn);
	                        if(parsedAnswer.success){
	                        	answerCn = parsedAnswer.answer
	                        }else {
	                        	answerCn = parsedAnswer.error
	                        	
	                        }
	                        let displayQstn = item.qstnCn.length > 20 ? item.qstnCn.substring(0, 20) + "..." : item.qstnCn;
	                        let displayAnswer = answerCn.length > 30 ? answerCn.substring(0, 20) + "..." : answerCn;
                            
                            if (item.evl == 'U'){
                            	evlCn = '만족';
                            }else if (item.evl == 'D'){
                            	evlCn = '불만족';
                            }
                            const plainTextAnswer = answerCn.replace(/<[^>]*>/g, '');
	                        html += `<tr>
	                            <td>${rowNumber}</td>
	                            <td>${item.ownrNm || ''}</td>
	                            <td>${item.mbrId || ''}</td>
	                            <td>${displayQstn || ''}</td>
	                            <td>${displayAnswer}</td>
	                            <td>${evlCn}</td>
	                            <td>${formattedDate}</td>
	                        </tr>`;
	                    });
	                    
	                    if (typeof setPagination === 'function') {
	                        setPagination('paging', 'getDataList', response.data.paginationInfo);
	                    }
	                    $("#dataArea").html(html);
	                } else {
	                    html += `<tr>
	                        <td colspan="7">조회결과가 없습니다.</td>
	                    </tr>`;
	                    $("#dataArea").html(html);
	                    setPagination('paging', 'getDataList', response.data.paginationInfo);
	                }
                    
	            }
	        },
	        onError: (error) => console.error('에러:', error)
	    });
	}
	
	// Excel 다운로드 함수
	function fn_download() {
		var ownrNm = $("#ownrSelect").val();
	    var startDt = $("#startDt").val();
	    var endDt = $("#endDt").val();
	    
	    try {
	        customFetch({
	            url: '/mngr/promptDataDownload',
	            method: 'POST',
	            params: {
	                searchType: 'download',
	                ownrNm : ownrNm,
		            startDt : startDt,
		            endDt : endDt
	            },
	            responseType: 'blob',
	            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	            onSuccess: (blob) => {
	                // 이제 blob을 바로 사용 가능
	                const url = window.URL.createObjectURL(blob);
	                const a = document.createElement('a');
	                a.style.display = 'none';
	                a.href = url;
	                
	                const now = new Date();
	                const dateStr = now.getFullYear() + 
	                               String(now.getMonth() + 1).padStart(2, '0') + 
	                               String(now.getDate()).padStart(2, '0') + '_' +
	                               String(now.getHours()).padStart(2, '0') + 
	                               String(now.getMinutes()).padStart(2, '0') + 
	                               String(now.getSeconds()).padStart(2, '0');
	                
	                a.download = `프롬프트현황_${dateStr}.xlsx`;
	                
	                document.body.appendChild(a);
	                a.click();
	                window.URL.revokeObjectURL(url);
	                document.body.removeChild(a);
	            },
	            onError: (error) => {
	                console.error('다운로드 오류:', error);
	            }
	        });
	    } catch (error) {
	        console.error('다운로드 오류:', error);
	    }
	}
	</script>
</body>
</html>