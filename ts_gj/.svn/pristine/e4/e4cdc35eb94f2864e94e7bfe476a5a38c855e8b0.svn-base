<!DOCTYPE html>
<html lang="ko" xmlns="http://www.w3.org/1999/xhtml" xmlns:th="https://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/thymeleaf-extras-springsecurity5">
<head>
	<th:block th:replace="/layout/head :: head-dashboard"></th:block>
	<script th:src="@{/js/egovframework/dashboard/todayOprStatus.js}"></script>
	<script th:src="@{/js/egovframework/dashboard/oprStatusTrend.js}"></script>
	<script th:src="@{/js/egovframework/dashboard/serviceUsageStatus.js}"></script>
	<script th:src="@{/js/egovframework/dashboard/vhclMapSvc.js}"></script>
	<script th:src="@{/js/egovframework/dashboard/gwangju.js}"></script>
</head>
<body>
<div id="wrap" class="wrap dashboard">
	<div id="container" class="container">
		<div class="contents">
			<!-- 상단 헤더 -->
    		<th:block th:replace="/layout/header :: top-menu-dashboard"></th:block>
    		<input type="hidden" id="ownrMaskedYn" th:value="${ownrMaskedYn}">
    		<input type="hidden" id="vhclMaskedYn" th:value="${vhclMaskedYn}">
    		<input type="hidden" id="oprtrMaskedYn" th:value="${oprtrMaskedYn}">
			<section class="dash_box">
				<div class="col ratio_4to6">
					<div class="dash_cont">
						<div class="cont_tit">
							<h2>금일 운행현황</h2>
						</div>
						<div class="cont_inner" id="vhclCntLoadginArea">
							<div class="total_box">
								<p class="total_tit">현재 운행 차량</p>
								<div class="total_inner">
									<p><span class="emp_text"><b id="oprVhclCnt"></b>대</span> / 총 <b id="totalVhclCnt"></b>대</p>
								</div>
							</div>
							<ul class="status_list">
								<li>
									<span class="status_cate">총 주행거리<em>(km)</em></span>
									<b class="status_value" id="totalOprDstnc"></b>
								</li>
								<li>
									<span class="status_cate">평균 연비<em>(km/m³)</em></span>
									<b class="status_value" id="totalFuelEconom"></b>
								</li>
								<li>
									<span class="status_cate">총 탄소배출<em>(kg)</em></span>
									<b class="status_value" id="totalCb"></b>
								</li>
								<li>
									<span class="status_cate">총 공회전<em>(시)</em></span>
									<b class="status_value" id="totalIdleTm"></b>
								</li>
							</ul>
						</div>
					</div>
					<div class="dash_cont">
						<div class="cont_tit">
							<h2>운행현황 추이</h2>
						</div>
						<div class="cont_inner" id="oprStatusTrendArea">
							<div class="graph_tit">
								<span id="oprStatusTrendTitle">주행거리<em>(km)</em></span>
							</div>
							<div class="graph_area">
								<div style="height: 100%;" id="oprStatusTrendChartDiv1"><!-- 그래프영역 --></div>
								<div style="height: 100%;" id="oprStatusTrendChartDiv2"><!-- 그래프영역 --></div>
								<div style="height: 100%;" id="oprStatusTrendChartDiv3"><!-- 그래프영역 --></div>
								<div style="height: 100%;" id="oprStatusTrendChartDiv4"><!-- 그래프영역 --></div>
								<a class="arrow_btn" title="그래프 이동" href="#"><i class="fa-solid fa-caret-right"></i></a>
							</div>
						</div>
					</div>
				</div>
				<div class="col">
					<div class="dash_map_wrap">
						<ul class="map_legend">
							<li class="driving">안전</li>
							<li class="garage">주의</li>
							<li class="error">경고</li>
						</ul>
						<div class="dash_map" id="mapChartDiv">
							<!-- 지도 영역 -->
							
							<!-- 운전원명 말풍선 -->
<!-- 							<div class="map_bubble">홍*동</div> -->
						</div>
						  
					</div>
				</div>
				<div class="col ratio_6to4">
					<div class="dash_cont">
						<div class="cont_tit">
							<h2>서비스 이용현황</h2>
						</div>
						<div class="cont_inner" id="serviceUsageStatusArea">
							<div class="total_box">
								<p class="total_tit">금일 접속수</p>
								<div class="total_inner">
									<ul>
										<li><em>정비사</em><span class="emp_text"><b id="mechanicUseCnt">-</b>회</span></li>
										<li><em>관리자</em><span><b id="adminUseCnt">-</b>회</span></li>
									</ul>
								</div>
							</div>
							<div class="graph_area">
								<div style="height: 100%;" id="serviceUsageStatusChartDiv"><!-- 그래프영역 --></div>
							</div>
						</div>
					</div>
					<div class="bus_info_cont" id="vhclInfoArea">
						<div class="bus_tit_area">
							<span class="model_tit" id="vhclInfoMdlInfo">-</span>
							<div class="bus_tit">
								<span>
									<i class="fa-solid fa-bus-simple"></i>
									<strong id="vhclInfoRegNo">-</strong>
								</span>
								<em id="fuelNm">-</em>
							</div>
						</div>
						<div class="bus_info_inner">
							<div class="info_tab">
								<ul>
									<li class="on" tabindex="0">기본정보</li>
									<li tabindex="0">진단정보</li>
									<li tabindex="0">운행행태</li>
								</ul>
							</div>
							<ul class="status_list list_tab01">
								<li>
									<span class="status_cate">주행거리<em>(km)</em></span>
									<b class="status_value" id="vhclInfoOprDstnc">-</b>
								</li>
								<li>
									<span class="status_cate">평균 연비<em>(km/m³)</em></span>
									<b class="status_value" id="vhclInfoFuelEconom">-</b>
								</li>
								<li>
									<span class="status_cate">총 탄소배출<em>(kg)</em></span>
									<b class="status_value" id="vhclInfoCb">-</b>
								</li>
								<li>
									<span class="status_cate">총 공회전<em>(시)</em></span>
									<b class="status_value" id="vhclInfoIdleTm">-</b>
								</li>
							</ul>
							<ul class="status_list type02 list_tab02">
								<li>
									<span class="status_cate">고장코드</span>
									<span class="status_info"><b class="status_value" id="bkdnCdListCnt">-</b>개 발생</span>
								</li>
								<li>
									<span class="status_cate">센서 진단 결과</span>
									<span class="status_info" id="chckList"><b class="status_item"><i class="fa-solid fa-triangle-exclamation"></i> -</b>점검필요</span>
								</li>
							</ul>
							<ul class="status_list type02 list_tab03">
								<li>
									<span class="status_cate">위험운행행태 건수</span>
									<span class="status_info"><b class="status_value" id="dgrListCnt">234</b>건 발생</span>
								</li>
								<li>
									<span class="status_cate">주요 행태</span>
									<span class="status_info"><b class="status_item" id="dgrList">급가속, 급정거</b></span>
								</li>
							</ul>
						</div>
					</div>

				</div>
			</section>
			
		</div>
	</div>
</div>

<script>
let oprStatusTrendRollingFlag = true;
let oprStatusTrendInterval = null;
let vehicleIndex = 0;

$(document).ready(function() {
	init();
	
	$("#ownrSelect").on("change", function() {
		// 운영사 변경 시 기존 업데이트 중지 후 새로 시작
		stopVehicleInfoUpdate();
		setOprVhclCnt();
		setOprStatusTrend();
		getVhclInfo(); // 즉시 한번 실행
		startvhclInfoAreaUpdate(); // 주기적 업데이트 재시작
		getServiceUsageStatusByUsers();
	});
});

function init(){
	setOprVhclCnt();
	setOprStatusTrend();
	setMap(); // 지도 초기화 후 자동으로 차량 정보 로딩 및 주기적 업데이트 시작
	getServiceUsageStatusByUsers();
}

//top util
$(".member_info").click(function() {
	$(this).toggleClass("on");
	$(".pop_util").fadeToggle('fast');
});

//tab menu
document.addEventListener("DOMContentLoaded", () => {
  const tabs = document.querySelectorAll(".bus_info_cont .info_tab li");
  const lists = document.querySelectorAll(".bus_info_cont .status_list");

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      // 탭 상태 변경
      tabs.forEach(t => t.classList.remove("on"));
      tab.classList.add("on");

      // 리스트 상태 변경
      lists.forEach(list => list.style.display = "none");
      const target = document.querySelector(`.list_tab0${index+1}`);
      if (target) target.style.display = "flex";
    });
  });
});

document.addEventListener('keydown', function(event) {
	  if (event.key === 'Enter' || event.key === ' ') {
	    // 현재 포커스된 요소가 클릭 가능한지 확인 후 클릭
	    const focusedElement = document.activeElement;
	    if (focusedElement && typeof focusedElement.click === 'function') {
	      focusedElement.click();
	    }
	  }
	});


</script>

</body>
</html>