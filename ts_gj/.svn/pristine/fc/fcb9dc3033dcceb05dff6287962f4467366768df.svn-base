<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.theimc.stat.service.impl.StatMapper">

    <!-- 통계 로그 저장 -->
    <insert id="insertStat" parameterType="java.util.Map">
        INSERT INTO svc_stat_use (
            svc_nm,
            svc_nm2,
            ctrl_nm,
            mthd_nm,
            ownr_nm,
            mbr_id,
            mbr_role,
            process_time,
            act_type_cd,
            err_cd,
            err_msg,
            req_url,
            req_info,
            req_params,
            ip_addr,
            brwsr_info,
            session_id,
            device_type
        ) VALUES (
            #{svcNm},
            #{svcNm2},
            #{ctrlNm},
            #{mthdNm},
            #{ownrNm},
            #{mbrId},
            #{mbrRole},
            #{processTime},
            #{actTypeCd},
            #{errCd},
            #{errMsg},
            #{reqUrl},
            #{reqInfo},
            #{reqParams},
            #{ipAddr},
            #{brwsrInfo},
            #{sessionId},
            #{deviceType}
        )
    </insert>
    
    <!-- 통계 목록 조회 -->
    <select id="selectStatList" parameterType="java.util.Map" resultType="egovMap">
        SELECT
            sn,
            svc_nm AS svcNm,
            ctrl_nm AS ctrlNm,
            mthd_nm AS mthdNm,
            mbr_id AS mbrId,
            mbr_role AS mbrRole,
            process_time AS processTime,
            act_type_cd AS actTypeCd,
            err_cd AS errCd,
            err_msg AS errMsg,
            req_url AS reqUrl,
            req_info AS reqInfo,
            ip_addr AS ipAddr,
            brwsr_info AS brwsrInfo,
            session_id AS sessionId,
            device_type AS deviceType,
            reg_dt AS regDt
        FROM
            svc_stat_use
        <where>
            <if test="svcNm != null and svcNm != ''">
                AND svc_nm = #{svcNm}
            </if>
            <if test="mbrId != null and mbrId != ''">
                AND mbr_id = #{mbrId}
            </if>
            <if test="actTypeCd != null and actTypeCd != ''">
                AND act_type_cd = #{actTypeCd}
            </if>
            <if test="startDate != null and startDate != ''">
                AND reg_dt >= #{startDate}
            </if>
            <if test="endDate != null and endDate != ''">
                AND reg_dt &lt;= #{endDate}
            </if>
        </where>
        ORDER BY reg_dt DESC
        <if test="recordCountPerPage != null and recordCountPerPage != 0">
            LIMIT #{firstIndex}, #{recordCountPerPage}
        </if>
    </select>
    
    <!-- 통계 개수 조회 -->
    <select id="selectStatListTotCnt" parameterType="java.util.Map" resultType="int">
        SELECT
            COUNT(*)
        FROM
            svc_stat_use
        <where>
            <if test="svcNm != null and svcNm != ''">
                AND svc_nm = #{svcNm}
            </if>
            <if test="mbrId != null and mbrId != ''">
                AND mbr_id = #{mbrId}
            </if>
            <if test="actTypeCd != null and actTypeCd != ''">
                AND act_type_cd = #{actTypeCd}
            </if>
            <if test="startDate != null and startDate != ''">
                AND reg_dt >= #{startDate}
            </if>
            <if test="endDate != null and endDate != ''">
                AND reg_dt &lt;= #{endDate}
            </if>
        </where>
    </select>
    
    <!-- 서비스별 통계 요약 정보 -->
    <select id="selectStatSummaryBySvc" parameterType="java.util.Map" resultType="egovMap">
        SELECT
            svc_nm AS svcNm,
            COUNT(*) AS callCount,
            AVG(process_time) AS avgProcessTime,
            MAX(process_time) AS maxProcessTime,
            MIN(process_time) AS minProcessTime,
            SUM(CASE WHEN act_type_cd = 'S' THEN 1 ELSE 0 END) AS successCount,
            SUM(CASE WHEN act_type_cd = 'E' THEN 1 ELSE 0 END) AS errorCount
        FROM
            svc_stat_use
        <where>
            <if test="startDate != null and startDate != ''">
                AND reg_dt >= #{startDate}
            </if>
            <if test="endDate != null and endDate != ''">
                AND reg_dt &lt;= #{endDate}
            </if>
        </where>
        GROUP BY
            svc_nm
        ORDER BY
            callCount DESC
    </select>
    
    <!-- 사용자별 통계 요약 정보 -->
    <select id="selectStatSummaryByUser" parameterType="java.util.Map" resultType="egovMap">
        SELECT
            mbr_id AS mbrId,
            mbr_role AS mbrRole,
            COUNT(*) AS callCount,
            COUNT(DISTINCT svc_nm) AS svcCount,
            MAX(reg_dt) AS lastAccessDt
        FROM
            svc_stat_use
        <where>
            <if test="startDate != null and startDate != ''">
                AND reg_dt >= #{startDate}
            </if>
            <if test="endDate != null and endDate != ''">
                AND reg_dt &lt;= #{endDate}
            </if>
            AND mbr_id IS NOT NULL AND mbr_id != ''
        </where>
        GROUP BY
            mbr_id, mbr_role
        ORDER BY
            callCount DESC
    </select>
    
    <!-- 디바이스별 통계 -->
    <select id="selectStatSummaryByDevice" parameterType="java.util.Map" resultType="egovMap">
        SELECT
            device_type AS deviceType,
            COUNT(*) AS callCount,
            COUNT(DISTINCT mbr_id) AS userCount,
            AVG(process_time) AS avgProcessTime
        FROM
            svc_stat_use
        <where>
            <if test="startDate != null and startDate != ''">
                AND reg_dt >= #{startDate}
            </if>
            <if test="endDate != null and endDate != ''">
                AND reg_dt &lt;= #{endDate}
            </if>
            AND device_type IS NOT NULL AND device_type != ''
        </where>
        GROUP BY
            device_type
        ORDER BY
            callCount DESC
    </select>
</mapper>