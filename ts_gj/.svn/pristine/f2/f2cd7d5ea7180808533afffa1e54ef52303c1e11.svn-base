<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.theimc.operation.service.impl.ReportMapper">

    <!-- 운전습관 리포트 - 운전원별 현황 -->
    <select id="selectDriverList" resultType="egovMap">
    	SELECT cori.oprtr_id
    		 , cori.ownr_nm
    		 , cori.rfid_no
			 , CAST(AES_DECRYPT(FROM_BASE64(cori.oprtr_nm), 'theimc') AS CHAR(100) CHARACTER SET UTF8MB4) AS oprtr_nm
    		 , cori.lbl
    		 , cori.reg_dt
    		 , cori.mdfcn_dt
    		 , aoor.oprtr_rpt_sn
    		 , aoor.rpt_ym
    		 , aoor.opr_scr
    	FROM anls_oprtr_opr_rpt aoor
    	LEFT OUTER JOIN cmm_oprtr_rfid_info cori
    	ON aoor.oprtr_id = cori.oprtr_id
    	WHERE 1 = 1
    	AND aoor.opr_scr IS NOT NULL
    	AND aoor.rpt_ym = #{rptYm}
   		<if test="oprtrNm != null and oprtrNm != ''">
   			AND CAST(AES_DECRYPT(FROM_BASE64(cori.oprtr_nm), 'theimc') AS CHAR(100) CHARACTER SET UTF8MB4) LIKE CONCAT('%', #{oprtrNm}, '%')
   	    </if>
   	    <if test="authOwnrList != null and authOwnrList.size() > 0">
   	        AND aoor.ownr_nm IN
   	        <foreach collection="authOwnrList" item="ownr" open="(" close=")" separator=",">
   	            #{ownr}
   	        </foreach>
   	    </if>
   	    <if test="ownrNm != null and ownrNm != ''">
   	    	<choose>
    	    	<when test="ownrNm != 'all'">
    	    	and aoor.ownr_nm = #{ownrNm}
    	    	</when>
   	    	</choose>
   	    </if>
   	    ORDER BY opr_scr asc
    </select>
    
    <select id="selectDriverReportData1" resultType="egovMap">
	    WITH daily_stats AS (
		    SELECT 
		        s.oprtr_id,
		        s.vhcl_sn,
		        s.ownr_nm,
		        DATE(s.anls_ymd) AS day,
		        AVG(s.fuel_ecnm) AS daily_fuel_ecnm,
		        AVG(s.opr_dstnc) AS daily_opr_dstnc,
		        AVG(s.cb) AS daily_cb,
		        AVG(s.idle_tm) AS daily_idle_tm,
		        AVG(s.rpm2000_ovr_cnt) AS daily_rpm2000_ovr_cnt
		    FROM anls_oprtr_opr_stat s
		    WHERE s.anls_ymd LIKE CONCAT(#{rptYm}, '%')
		    <if test="authOwnrList != null and authOwnrList.size() > 0">
		        AND s.ownr_nm IN
		        <foreach collection="authOwnrList" item="ownr" open="(" close=")" separator=",">
		            #{ownr}
		        </foreach>
		    </if>
		    <if test="ownrNm != null and ownrNm != ''">
		        <choose>
		            <when test="ownrNm != 'all'">
		                AND s.ownr_nm = #{ownrNm}
		            </when>
		        </choose>
		    </if>
		    GROUP BY s.oprtr_id, s.vhcl_sn, DATE(s.anls_ymd)
		),
		monthly_stats_oprtr AS (
		    SELECT
		        d.oprtr_id,
		        v.ownr_nm,
		        DATE_FORMAT(d.day, '%Y-%m') AS month,
		        IFNULL(ROUND(AVG(d.daily_opr_dstnc), 2), 0) AS avg_opr_dstnc,
		        IFNULL(ROUND(AVG(d.daily_cb), 2), 0) AS avg_cb,
		        IFNULL(ROUND(AVG(d.daily_idle_tm), 2), 0) AS avg_idle_tm,
		        IFNULL(ROUND(AVG(d.daily_rpm2000_ovr_cnt), 2), 0) AS avg_rpm2000_ovr_cnt,
		        IFNULL(ROUND(AVG(CASE WHEN v.fuel_cd IN ('FU06', 'FU02') THEN d.daily_fuel_ecnm END), 2), 0) AS avg_cng_ecnm,
		        IFNULL(ROUND(AVG(CASE WHEN v.fuel_cd = 'FU05' THEN d.daily_fuel_ecnm END), 2), 0) AS avg_hydrogen_ecnm,
		        IFNULL(ROUND(AVG(CASE WHEN v.fuel_cd = 'FU04' THEN d.daily_fuel_ecnm END), 2), 0) AS avg_electric_ecnm
		    FROM daily_stats d
		    JOIN cmm_vhcl_info v ON d.vhcl_sn = v.vhcl_sn
		    GROUP BY d.oprtr_id, v.ownr_nm, DATE_FORMAT(d.day, '%Y-%m')
		),
		monthly_stats_owner AS (
		    SELECT
		        v.ownr_nm,
		        DATE_FORMAT(d.day, '%Y-%m') AS month,
		        IFNULL(ROUND(AVG(d.daily_opr_dstnc), 2), 0) AS avg_opr_dstnc,
		        IFNULL(ROUND(AVG(d.daily_cb), 2), 0) AS avg_cb,
		        IFNULL(ROUND(AVG(d.daily_idle_tm), 2), 0) AS avg_idle_tm,
		        IFNULL(ROUND(AVG(d.daily_rpm2000_ovr_cnt), 2), 0) AS avg_rpm2000_ovr_cnt,
		        IFNULL(ROUND(AVG(CASE WHEN v.fuel_cd IN ('FU06', 'FU02') THEN d.daily_fuel_ecnm END), 2), 0) AS avg_cng_ecnm,
		        IFNULL(ROUND(AVG(CASE WHEN v.fuel_cd = 'FU05' THEN d.daily_fuel_ecnm END), 2), 0) AS avg_hydrogen_ecnm,
		        IFNULL(ROUND(AVG(CASE WHEN v.fuel_cd = 'FU04' THEN d.daily_fuel_ecnm END), 2), 0) AS avg_electric_ecnm
		    FROM daily_stats d
		    JOIN cmm_vhcl_info v ON d.vhcl_sn = v.vhcl_sn
		    GROUP BY v.ownr_nm, DATE_FORMAT(d.day, '%Y-%m')
		)
		SELECT metric_name, `운전원`, `운수회사 평균`
		FROM (
			SELECT 4 AS order_no, '운행거리(km)' AS metric_name, d.avg_opr_dstnc AS '운전원', o.avg_opr_dstnc AS '운수회사 평균'
			FROM monthly_stats_oprtr d
			JOIN monthly_stats_owner o ON d.ownr_nm = o.ownr_nm AND d.month = o.month
			WHERE d.oprtr_id = #{oprtrId}
			
			UNION ALL
			SELECT 5, '탄소배출량(g/km)', d.avg_cb, o.avg_cb
			FROM monthly_stats_oprtr d
			JOIN monthly_stats_owner o ON d.ownr_nm = o.ownr_nm AND d.month = o.month
			WHERE d.oprtr_id = #{oprtrId}
			
			UNION ALL
			SELECT 6, '공회전 시간(분)', d.avg_idle_tm, o.avg_idle_tm
			FROM monthly_stats_oprtr d
			JOIN monthly_stats_owner o ON d.ownr_nm = o.ownr_nm AND d.month = o.month
			WHERE d.oprtr_id = #{oprtrId}
			
			UNION ALL
			SELECT 7, '고 RPM(분)', d.avg_rpm2000_ovr_cnt, o.avg_rpm2000_ovr_cnt
			FROM monthly_stats_oprtr d
			JOIN monthly_stats_owner o ON d.ownr_nm = o.ownr_nm AND d.month = o.month
			WHERE d.oprtr_id = #{oprtrId}
			
			UNION ALL
			SELECT 1, '연비(km/m³)', d.avg_cng_ecnm, o.avg_cng_ecnm
			FROM monthly_stats_oprtr d
			JOIN monthly_stats_owner o ON d.ownr_nm = o.ownr_nm AND d.month = o.month
			WHERE d.oprtr_id = #{oprtrId}
			
			UNION ALL
			SELECT 3, '수소전비(km/kWh)', d.avg_hydrogen_ecnm, o.avg_hydrogen_ecnm
			FROM monthly_stats_oprtr d
			JOIN monthly_stats_owner o ON d.ownr_nm = o.ownr_nm AND d.month = o.month
			WHERE d.oprtr_id = #{oprtrId}
			
			UNION ALL
			SELECT 2, '전비(km/kWh)', d.avg_electric_ecnm, o.avg_electric_ecnm
			FROM monthly_stats_oprtr d
			JOIN monthly_stats_owner o ON d.ownr_nm = o.ownr_nm AND d.month = o.month
			WHERE d.oprtr_id = #{oprtrId}
		) t
		ORDER BY order_no DESC
    </select>
    
    <select id="selectDriverReportData2" resultType="egovMap">
    	WITH filtered AS (
		    SELECT *
		    FROM anls_oprtr_opr_stat
		    WHERE oprtr_id = #{oprtrId}
		      AND anls_ymd LIKE CONCAT(#{rptYm}, '%')
		)
		SELECT '과속수' AS `구분`, IFNULL(SUM(ovr_spd_cnt), 0) AS `건수` FROM filtered
		UNION ALL
		SELECT '급감속수', IFNULL(SUM(sud_dclr_cnt), 0) FROM filtered
		UNION ALL
		SELECT '급가속수', IFNULL(SUM(sud_accl_cnt), 0) FROM filtered
		UNION ALL
		SELECT '급정지수', IFNULL(SUM(sud_stop_cnt), 0) FROM filtered
		UNION ALL
		SELECT '급출발수', IFNULL(SUM(sud_strt_cnt), 0) FROM filtered
		UNION ALL
		SELECT '장기과속수', IFNULL(SUM(lng_ovr_spd_cnt), 0) FROM filtered
    </select>
    
    <select id="selectDriverReportData3" resultType="egovMap">
    	WITH filtered AS (
		    SELECT 
		        oprtr_id,
		        anls_doc,
		        ovr_spd_cnt,
		        sud_dclr_cnt,
		        sud_accl_cnt,
		        sud_stop_cnt,
		        sud_strt_cnt,
		        lng_ovr_spd_cnt,
		        ownr_nm
		    FROM anls_oprtr_opr_stat
		    WHERE anls_ymd LIKE CONCAT(#{rptYm}, '%')
		)
		, oprtr_avg AS (
		    SELECT 
		        f.anls_doc AS day,
		        IFNULL(ROUND(AVG(
		            f.ovr_spd_cnt
		          + f.sud_dclr_cnt
		          + f.sud_accl_cnt
		          + f.sud_stop_cnt
		          + f.sud_strt_cnt
		          + f.lng_ovr_spd_cnt
		        ), 0), 0) AS 운전원
		    FROM filtered f
		    WHERE f.oprtr_id = #{oprtrId}
		    GROUP BY f.anls_doc
		)
		, ownr_avg AS (
		    SELECT 
		        f.anls_doc AS day,
		        IFNULL(ROUND(AVG(
		            f.ovr_spd_cnt
		          + f.sud_dclr_cnt
		          + f.sud_accl_cnt
		          + f.sud_stop_cnt
		          + f.sud_strt_cnt
		          + f.lng_ovr_spd_cnt
		        ), 0), 0) AS `운수회사 평균`
		    FROM filtered f
		    WHERE 1 = 1
		    <if test="authOwnrList != null and authOwnrList.size() > 0">
		        AND ownr_nm IN
		        <foreach collection="authOwnrList" item="ownr" open="(" close=")" separator=",">
		            #{ownr}
		        </foreach>
		    </if>
		    <if test="ownrNm != null and ownrNm != ''">
		        <choose>
		            <when test="ownrNm != 'all'">
		                AND ownr_nm = #{ownrNm}
		            </when>
		        </choose>
		    </if>
		    GROUP BY f.anls_doc
		)
		, days AS (
		    SELECT '월' AS day UNION ALL
		    SELECT '화' UNION ALL
		    SELECT '수' UNION ALL
		    SELECT '목' UNION ALL
		    SELECT '금' UNION ALL
		    SELECT '토' UNION ALL
		    SELECT '일'
		)
		SELECT 
		    d.day AS day,
		    IFNULL(o1.운전원, 0) AS 운전원,
		    IFNULL(o2.`운수회사 평균`, 0) AS `운수회사 평균`
		FROM days d
		LEFT JOIN oprtr_avg o1 ON d.day = o1.day
		LEFT JOIN ownr_avg o2 ON d.day = o2.day
		ORDER BY FIELD(d.day, '월','화','수','목','금','토','일') DESC
    </select>
    
    <select id="selectDriverReport" resultType="egovMap">
    	WITH ranked AS (
		    SELECT 
	            aoor.oprtr_id, 
			    LEAST(
			        ROUND(PERCENT_RANK() OVER (ORDER BY aoor.opr_scr DESC) * 100, 0),
			        ROUND(PERCENT_RANK() OVER (ORDER BY aoor.opr_scr ASC) * 100, 0)
			    ) AS opr_scr_percentile_min,
			    LEAST(
			        ROUND(PERCENT_RANK() OVER (ORDER BY aoor.ecnm_scr DESC) * 100, 0),
			        ROUND(PERCENT_RANK() OVER (ORDER BY aoor.ecnm_scr ASC) * 100, 0)
			    ) AS ecnm_scr_percentile_min,
			    CASE 
			        WHEN ROUND(PERCENT_RANK() OVER (ORDER BY opr_scr DESC) * 100, 0) <![CDATA[<=]]>
			             ROUND(PERCENT_RANK() OVER (ORDER BY opr_scr ASC) * 100, 0)
			        THEN '상위'
			        ELSE '하위'
			    END AS opr_scr_rank_type,
			    CASE 
			        WHEN ROUND(PERCENT_RANK() OVER (ORDER BY ecnm_scr DESC) * 100, 0) <![CDATA[<=]]>
			             ROUND(PERCENT_RANK() OVER (ORDER BY ecnm_scr ASC) * 100, 0)
			        THEN '상위'
			        ELSE '하위'
			    END AS ecnm_scr_rank_type
		    FROM anls_oprtr_opr_rpt aoor
		    WHERE aoor.rpt_ym = REPLACE(#{rptYm}, '-', '')
		    <if test="authOwnrList != null and authOwnrList.size() > 0">
		        AND aoor.ownr_nm IN
		        <foreach collection="authOwnrList" item="ownr" open="(" close=")" separator=",">
		            #{ownr}
		        </foreach>
		    </if>
		    <if test="ownrNm != null and ownrNm != ''">
		        <choose>
		            <when test="ownrNm != 'all'">
		                AND aoor.ownr_nm = #{ownrNm}
		            </when>
		        </choose>
		    </if>
		)
		SELECT
		    aoor.ownr_nm,
		    aoor.oprtr_id,
		    cofi.rfid_no,
		    CAST(AES_DECRYPT(FROM_BASE64(cofi.oprtr_nm), 'theimc') AS CHAR(100) CHARACTER SET UTF8MB4) AS oprtr_nm,
		    aoor.rpt_ym,
		    aoor.opr_scr,
		    aoor.ecnm_scr,
		    r.opr_scr_percentile_min,
		    r.opr_scr_rank_type,
		    r.ecnm_scr_percentile_min,
		    r.ecnm_scr_rank_type,
		    IFNULL(main_rte.rte_sn, '-') AS main_rte_sn,
		    IFNULL(main_rte.rte_nm, '-') AS main_rte_nm,
		    IFNULL(ROUND((aoos_sum.total_opr_tm / aoos_sum.days), 2), 0) AS avg_opr_tm,
		    aoor.dgr_opr_lc_cn,
		    aoor.opr_tm_dgr_cn,
		    aoor.bk_tm_cn,
		    aoor.ai_chck_cn
		FROM anls_oprtr_opr_rpt aoor
		LEFT JOIN cmm_oprtr_rfid_info cofi
		    ON aoor.oprtr_id = cofi.oprtr_id
		LEFT JOIN (
		    SELECT oprtr_id, SUM(opr_tm) AS total_opr_tm, COUNT(DISTINCT anls_ymd) AS days
		    FROM anls_oprtr_opr_stat
		    WHERE anls_ymd LIKE CONCAT(#{rptYm}, '%')
		    GROUP BY oprtr_id
		) aoos_sum
		    ON aoor.oprtr_id = aoos_sum.oprtr_id
		LEFT JOIN (
		    SELECT oprtr_id, rte_sn, rte_nm
		    FROM (
		        SELECT 
		            aoos.oprtr_id,
		            aoos.rte_sn,
		            cri.rte_nm,
		            ROW_NUMBER() OVER (PARTITION BY aoos.oprtr_id ORDER BY COUNT(*) DESC) AS rn
		        FROM anls_oprtr_opr_stat aoos
		        LEFT JOIN cmm_rte_info cri
		            ON aoos.rte_sn = cri.rte_sn
		        WHERE aoos.anls_ymd LIKE CONCAT(#{rptYm}, '%')
		        GROUP BY aoos.oprtr_id, aoos.rte_sn
		    ) t
		    WHERE rn = 1
		) main_rte
		    ON aoor.oprtr_id = main_rte.oprtr_id
		LEFT JOIN ranked r
		    ON aoor.oprtr_id = r.oprtr_id
		WHERE aoor.oprtr_id = #{oprtrId}
		  AND aoor.rpt_ym = REPLACE(#{rptYm}, '-', '')
    </select>
    
</mapper>