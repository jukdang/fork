<!-- ai 아이콘 애니메이션 -->
<th:block th:fragment="ai-icon">
  <svg class="ai_icon_animation"
       viewBox="-5 -5 120 120"
       xmlns="http://www.w3.org/2000/svg"
       preserveAspectRatio="xMidYMid meet">
    <defs>
      <!-- 오라 그라데이션: AI 네온 느낌 -->
       <radialGradient id="softAura" cx="50%" cy="50%" r="70%">
	    <stop offset="0%" stop-color="#2e8cff" stop-opacity="0.3"/>   <!-- 중심 은은 -->
	    <stop offset="35%" stop-color="#50c9ff" stop-opacity="0.15"/> <!-- 청록 더 은은 -->
	    <stop offset="70%" stop-color="#a872eb" stop-opacity="0.08"/> <!-- 퍼플 거의 희미 -->
	    <stop offset="100%" stop-color="#2400a2" stop-opacity="0"/>   <!-- 외곽 소멸 -->
	  </radialGradient>
	
	  <!-- Blur -->
	  <filter id="softBlur">
	    <feGaussianBlur in="SourceGraphic" stdDeviation="2.5"/>
	  </filter>
	</defs>

      <!-- 아이콘 그라데이션 -->
      <linearGradient id="grad1" x1="0" y1="68.79" x2="82.08" y2="68.79" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#2400a2"/>
        <stop offset="1" stop-color="#2e8cff"/>
      </linearGradient>
      <linearGradient id="grad2" x1="17.19" y1="14.4" x2="101.37" y2="85.04" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#db5a3e"/>
        <stop offset=".56" stop-color="#a872eb"/>
        <stop offset="1" stop-color="#50c9ff"/>
      </linearGradient>
    </defs>

    <!-- 오라 (아이콘보다 살짝 크게) -->
    <circle class="aura"
            cx="55" cy="55" r="60"
            fill="url(#softAura)"
            filter="url(#softBlur)"
            opacity="0"/>

    <!-- 아이콘 -->
    <g id="icon" opacity="0">
      <path fill="#272425"
