<!-- 탑메뉴 : S -->
<th:block th:fragment="top-menu">

	<header class="header" id="header">
		<div class="header_left">
			<a class="menu-trigger mobile_btn" href="#">
				<span></span>
				<span></span>
				<span></span>
			</a>
			<div id="logo" title="메인 페이지로 이동">
			    <a th:href="@{${currentMbrRole == 'ROLE_MECHANIC' ? '/vehicle/diagnosisRealtime' : '/'}}">
			        <span>광주 시내버스 관제</span>
			    </a>
			</div>
		</div>
		
		<nav class="top_menu">
			<!-- 차량 정비 -->
			<ul th:if="${pageInfo['pageMenuName'] == 'vehicle'}">
				<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'diagnosisRealtime'} ? ' on'"><a th:href="@{/vehicle/diagnosisRealtime}">AI 실시간 진단</a></li>
				<!-- <li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'diagnosisRealtimeResult'} ? ' on'"><a th:href="@{/vehicle/diagnosisRealtimeResult}">AI 실시간 결과</a></li> -->
				<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'diagnosisHistory'} ? ' on'"><a th:href="@{/vehicle/diagnosisHistory}">진단 내역</a></li>
				<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'repairAssist'} ? ' on'"><a th:href="@{/vehicle/repairAssist}">AI + 정비 도우미</a></li>
<!-- 				<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'inspectionHistory'} ? ' on'"><a th:href="@{/vehicle/inspectionHistory}">정기검사 이력</a></li> -->
			</ul>
			<!-- 운행 행태 -->
			<ul th:if="${pageInfo['pageMenuName'] == 'operation'}">
			    <li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'report'} ? ' on'"><a th:href="@{/operation/driverList}">운전습관 리포트</a></li>
				<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'aiReport'} ? ' on'"><a th:href="@{/operation/aiReportList}">AI + 리포트</a></li>
				<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'drivingLog'} ? ' on'"><a th:href="@{/operation/drivingLogList}">운행 일지</a></li>
				<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'status'} ? ' on'"><a th:href="@{/operation/routeOprHist}">운행현황판</a></li>
			</ul>
			<!-- 데이터 블랙박스 -->
			<ul th:if="${pageInfo['pageMenuName'] == 'blackbox'}">
			    <li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'blackbox'} ? ' on'"><a th:href="@{/blackbox/blackbox}">데이터 블랙박스</a></li>
			</ul>
		</nav>
		
		<div class="user" sec:authorize="isAnonymous()">
			<span>
				<a class="member_info" th:href="@{/login/loginForm}">로그인</a>
			</span>
		</div>
		
		<div class="user" sec:authorize="isAuthenticated()">
			<a class="member_info" href="#">
				<i class="fa-solid fa-circle-user"></i>
		  		<em><span sec:authentication="name"></span> 님</em>
		  		<i class="fas fa-angle-down"></i>
			</a>
			
			
			<div class="pop_util">
				<ul class="list_util">
					<li>
						<a th:href="@{/mbr/chkMbrPswdForm}"><i class="fa-solid fa-user"></i>마이페이지</a>
					</li>
					<li th:if="${currentMbrRole == 'ROLE_ADMIN' or currentMbrRole == 'ROLE_MANAGER'}">
						<a th:href="@{/mngr/mbr/mbrList}"><i class="fas fa-cog"></i>관리자 페이지</a>
					</li>
					<li>
						<a href="#" class="logout" onclick="document.getElementById('logoutForm').submit(); return false;">
							<i class="fa-solid fa-arrow-right-from-bracket"></i>로그아웃
						</a>
						<form id="logoutForm" th:action="@{/logout}" method="post" style="display:none;">
						</form>
					</li>
				</ul>
			</div>
		</div>
	</header>
	
	
	<div class="wh_bg" style="display: none;">
		<!-- 모바일 메뉴 버튼 -->
		<a class="menu-trigger mobile_btn type active-3" href="#">
			<span></span>
			<span></span>
			<span></span>
		</a>
		<!-- 차량 정비 -->
		<ul class="mobile_menu mobile_menu01" th:if="${pageInfo['pageMenuName'] == 'vehicle'}">
			<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'diagnosisRealtime'} ? ' on'"><a th:href="@{/vehicle/diagnosisRealtime}">AI 실시간 진단</a></li>
			<!-- <li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'diagnosisRealtimeResult'} ? ' on'"><a th:href="@{/vehicle/diagnosisRealtimeResult}">AI 실시간 결과</a></li> -->
			<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'diagnosisHistory'} ? ' on'"><a th:href="@{/vehicle/diagnosisHistory}">진단 내역</a></li>
			<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'repairAssist'} ? ' on'"><a th:href="@{/vehicle/repairAssist}">AI + 정비 도우미</a></li>
<!-- 			<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'inspectionHistory'} ? ' on'"><a th:href="@{/vehicle/inspectionHistory}">정기검사 이력</a></li> -->
		</ul>
		<!-- 운행 행태 -->
		<ul class="mobile_menu mobile_menu02" th:if="${pageInfo['pageMenuName'] == 'operation'}">
            <li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'report'} ? ' on'"><a th:href="@{/operation/driverList}">운전습관 리포트</a></li>
			<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'aiReport'} ? ' on'"><a th:href="@{/operation/aiReportList}">AI + 리포트</a></li>
			<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'drivingLog'} ? ' on'"><a th:href="@{/operation/drivingLogList}">운행 일지</a></li>
			<li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'status'} ? ' on'"><a th:href="@{/operation/routeOprHist}">운행현황판</a></li>
		</ul>
		<!-- 데이터 블랙박스 -->
		<ul class="mobile_menu mobile_menu03" th:if="${pageInfo['pageMenuName'] == 'blackbox'}">
            <li th:classappend="${pageInfo != null and pageInfo['pageSubMenuName'] == 'blackbox'} ? ' on'"><a th:href="@{/blackbox/blackbox}">데이터 블랙박스</a></li>
		</ul>
	</div>
	<input type="hidden" id="ownrMaskedYn" th:value="${ownrMaskedYn}">
	<input type="hidden" id="vhclMaskedYn" th:value="${vhclMaskedYn}">
	<input type="hidden" id="oprtrMaskedYn" th:value="${oprtrMaskedYn}">
	<script>
		var contextPath = $('#contextPathHolder').attr('data-contextPath') ? $('#contextPathHolder').attr('data-contextPath') : '';
		window.onload = function() {
			
			// top util
			$(".member_info").click(function() {
				$(this).toggleClass("on");
				$(".pop_util").fadeToggle('fast');
			});
			
			const body = $('body');
			const bgMenu = $('.wh_bg');
			const burger = $('.menu-trigger');
			const burger2 = $('.mobile_btn.type');
			
			burger.each(function(index){
			  var $this = $(this);
			  
			  $this.on('click', function(e){
				e.preventDefault();
				$(this).addClass('active-' + (index+2));
				bgMenu.fadeIn();
				body.addClass('hidden');
				burger2.addClass('active-' + (index+2));
			  })
			});
			
			burger2.click(function(){
				$(this).removeClass('active-2');
				burger.removeClass('active-2');
				bgMenu.fadeOut();
				body.removeClass('hidden');
			});
		}
	</script>
    
</th:block>
<!-- 탑메뉴 : E -->

<!-- 레프트메뉴 : S -->
<th:block th:fragment="left-menu">

	<header class="header" id="header">
		<div id="logo" title="HOME">
			<a th:href="@{/}">
				<span>일반 페이지</span>
			</a>
		</div>
		<div class="util">
				<span sec:authorize="isAnonymous()">
					<a class="member_info" th:href="@{/login/loginForm}">로그인</a>
				</span>
				<div class="user" sec:authorize="isAuthenticated()">
					<a class="member_info" href="#">
						<i class="fa-solid fa-circle-user"></i>
				  		<span sec:authentication="name"></span>
				  		<i class="fas fa-angle-down"></i>
					</a>
					<div>
						<ul class="list_util">
							<li sec:authorize="hasRole('ROLE_ADMIN')">
								<a th:href="@{/mngr/mbr/mbrList}">관리자</a>
							</li>
							<li>
								<a th:href="@{/mbr/chkMbrPswdForm}">회원정보</a>
							</li>
							<li>
								<a href="#" class="logout" onclick="document.getElementById('logoutForm').submit(); return false;">
									<em>로그아웃</em>
								</a>
								<form id="logoutForm" th:action="@{/logout}" method="post" style="display:none;">
								</form>
							</li>
						</ul>
					</div>
				</div>
			<div id="btn_bar">
				<div class="ico_bar" title="menu">
					<span></span>
					<span></span>
					<span></span>
				</div>
			</div>
		</div>
	</header>

	<a title="닫기" href="#" class="btn_hide"><i class="fas fa-caret-left"></i></a>
	<script>
		var contextPath = $('#contextPathHolder').attr('data-contextPath') ? $('#contextPathHolder').attr('data-contextPath') : '';
		window.onload = function() {
			// 메뉴 열고 닫히기
			$(document).ready(function () {
			    $('.dropdown').on('click', function () {
			        // 모든 dropdown에서 'on' 제거
			        $('.dropdown').not($(this).closest('.dropdown')).removeClass('on');
			
			        // 클릭한 요소의 dropdown에만 'on' 토글
			        $(this).closest('.dropdown').toggleClass('on');
			    });
			});
			
			//height full aside hide
			$(".btn_hide").click(function() {
				$(".wrap").toggleClass("hide");
			});
			
			//햄버거 메뉴
			$(".util .ico_bar").click(function() {
				$("#snb").toggleClass("open");
			});
			
			// top util
			$(".member_info").click(function() {
				$(".list_util").fadeToggle('fast');
			});
		}
	</script>
		
</th:block>
<!-- 레프트메뉴 : E -->

<!-- 대시보드 : S -->
<th:block th:fragment="top-menu-dashboard">
	<section class="dash_header">
		<div class="header_wrap">
			<div class="dash_title"><h1><span th:text="${@maskingUtils.maskOwnerName(currentOwnrNm)}"></span> 시내버스 관제</h1><div th:replace="/common/ownrSelect :: mngr-select"></div></div>
			<div class="header_right">
				<p class="time">
				<span id="currentDate">2025.05.04</span>
				<em id="currentTime">15:43:52</em>
				</p>
				
				<script>
					function updateCurrentTime() {
					   const now = new Date();
					   
					   // 날짜 형식: YYYY.MM.DD
					   const year = now.getFullYear();
					   const month = String(now.getMonth() + 1).padStart(2, '0');
					   const day = String(now.getDate()).padStart(2, '0');
					   const dateString = `${year}.${month}.${day}`;
					   
					   // 시간 형식: HH:mm:ss
					   const hours = String(now.getHours()).padStart(2, '0');
					   const minutes = String(now.getMinutes()).padStart(2, '0');
					   const seconds = String(now.getSeconds()).padStart(2, '0');
					   const timeString = `${hours}:${minutes}:${seconds}`;
					   
					   // DOM 업데이트
					   document.getElementById('currentDate').textContent = dateString;
					   document.getElementById('currentTime').textContent = timeString;
					}
					
					// 페이지 로드 시 즉시 실행
					updateCurrentTime();
					
					// 1초마다 업데이트
					setInterval(updateCurrentTime, 1000);
				</script>
				<div class="user">
					<a class="member_info" href="#">
				  		<em><span sec:authentication="name"></span> 님</em>
				  		<i class="fas fa-angle-down"></i>
					</a>
					<div class="pop_util">
						<ul class="list_util">
							<li>
								<a th:href="@{/}"><i class="fa-solid fa-house"></i>메인페이지</a>
							</li>
							<li>
								<a th:href="@{/mngr/mbr/mbrList}"><i class="fas fa-cog"></i>관리자 페이지</a>
							</li>
							<li>
								<a th:href="@{/mbr/chkMbrPswdForm}"><i class="fa-solid fa-user"></i>마이페이지</a>
							</li>
							<li>
								<a href="#" class="logout" onclick="document.getElementById('logoutForm').submit(); return false;">
									<i class="fa-solid fa-arrow-right-from-bracket"></i>로그아웃
								</a>
								<form id="logoutForm" th:action="@{/logout}" method="post" style="display:none;">
								</form>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
		
</th:block>
<!-- 대시보드 : E -->

<!-- 관리자 : S -->
