<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.theimc.mbr.service.impl.MbrMapper">
	
	<!-- 회원 본인 정보 등록 (사용자 가입용) -->
	<insert id="insertMbr" parameterType="egovframework.theimc.login.vo.MbrVO">
        INSERT INTO svc_mbr_data (
            mbr_id,
            mbr_pswd,
            mbr_nm,
			ownr_nm,
            mbr_role
        ) VALUES (
            #{mbrId},
            #{mbrPswd},
            #{mbrNm},
			#{ownrNm},
            #{mbrRole}
        )
    </insert>
    
    <!-- 회원 본인 정보 등록 (사용자 가입용) -->
   	<insert id="insertMbrSelf" parameterType="egovframework.theimc.login.vo.MbrVO">
        INSERT INTO svc_mbr_data (
            mbr_id,
            mbr_pswd,
            mbr_nm,
<!--             mbr_email, -->
<!--             mbr_tel_no, -->
            mbr_role,
            utztn_trms_agre_yn,
            prvc_clct_agre_yn
        ) VALUES (
            #{mbrId},
            #{mbrPswd},
            #{mbrNm},
<!--             #{mbrEmail}, -->
<!--             #{mbrTelNo}, -->
            'ROLE_USER',
            #{utztnTrmsAgreYn},
            #{prvcClctAgreYn}
        )
    </insert>
    
    <!-- 아이디 중복 체크 -->
	<select id="chkMbrId" resultType="int" parameterType="egovframework.theimc.login.vo.MbrVO">
        SELECT COUNT(*) FROM svc_mbr_data WHERE mbr_id = #{mbrId}
    </select>
    
    <!-- 회원 정보 수정 (관리자용) -->
    <update id="updateMbr" parameterType="egovframework.theimc.login.vo.MbrVO">
        UPDATE 
            svc_mbr_data
        SET 
            mbr_nm = #{mbrNm},
            ownr_nm = #{ownrNm},
<!--             mbr_email = #{mbrEmail}, -->
            <if test="mbrPswd != null and mbrPswd != ''">
            	mbr_pswd = #{mbrPswd},
            </if>
            mbr_role = #{mbrRole}
        WHERE 
            mbr_id = #{mbrId}
            <if test="dataFilter != null and dataFilter == 'ownr' and currentOwnrNm != null and currentOwnrNm != ''">
	            AND ownr_nm = #{currentOwnrNm}
	        </if>
    </update>
    
    <!-- 회원 본인 정보 수정 (사용자용) -->
    <update id="updateMbrSelf" parameterType="egovframework.theimc.login.vo.MbrVO">
        UPDATE 
            svc_mbr_data
        SET 
            mbr_nm = #{mbrNm},
<!--             mbr_tel_no = #{mbrTelNo}, -->
<!--             mbr_email = #{mbrEmail}, -->
            mbr_pswd = #{mbrPswd}
        WHERE 
            mbr_id = #{mbrId}
    </update>
    
    <!-- 회원 일괄 삭제 -->
	<delete id="deleteMbrArray" parameterType="egovframework.theimc.login.vo.MbrVO">
	    DELETE FROM svc_mbr_data 
	    WHERE mbr_sn IN
	    <foreach collection="selectedSns" item="sn" open="(" close=")" separator=",">
	        #{sn}
	    </foreach>
	</delete>
    
    <!-- 회원 목록 조회 -->
    <select id="selectMbrList" parameterType="HashMap" resultType="egovframework.theimc.login.vo.MbrVO">
        SELECT 
            mbr_sn as sn,
            mbr_id as mbrId,
            mbr_nm as mbrNm,
			CASE 
			    WHEN mbr_role = 'ROLE_ADMIN' THEN '시스템 관리자'
			    ELSE ownr_nm
			END AS ownrNm,
            mbr_role as mbrRole,
	        (SELECT max(last_act_dt) FROM svc_mbr_session sms WHERE smd.mbr_id = sms.mbr_id GROUP BY sms.mbr_id) as lastActDt
        FROM 
            svc_mbr_data smd
        <where>
    	    <!-- 권한별 운수회사 필터링 조건 (가장 먼저 적용) -->
	        <if test="dataFilter != null and dataFilter == 'ownr' and currentOwnrNm != null and currentOwnrNm != ''">
	            AND ownr_nm = #{currentOwnrNm}
	        </if>
			<choose>
				<when test="searchType == 'mbrId'">
					<if test="searchKeyword != null and searchKeyword != ''">
						AND mbr_id LIKE CONCAT('%', #{searchKeyword}, '%')
					</if>
				</when>
				<when test="searchType == 'mbrRole'">
					AND mbr_role = #{searchRole}
				</when>
				<when test="searchType == 'ownrNm'">
					<if test="searchKeyword != null and searchKeyword != ''">
						AND ownr_nm = #{searchKeyword}
					</if>
				</when>
			</choose>
        </where>
        ORDER BY 
            mbr_sn DESC
        LIMIT #{firstRecordIndex}, #{recordCountPerPage}
    </select>
    
    <!-- 전체 회원 수 조회 -->
    <select id="selectMbrTotalCnt" parameterType="HashMap" resultType="int">
        SELECT 
            COUNT(*)
        FROM 
            svc_mbr_data
        <where>
    	    <!-- 권한별 운수회사 필터링 조건 (가장 먼저 적용) -->
	        <if test="dataFilter != null and dataFilter == 'ownr' and currentOwnrNm != null and currentOwnrNm != ''">
	            AND ownr_nm = #{currentOwnrNm}
	        </if>
			<choose>
				<when test="searchType == 'mbrId'">
					<if test="searchKeyword != null and searchKeyword != ''">
						AND mbr_id LIKE CONCAT('%', #{searchKeyword}, '%')
					</if>
				</when>
				<when test="searchType == 'mbrRole'">
					AND mbr_role = #{searchRole}
				</when>
				<when test="searchType == 'ownrNm'">
					<if test="searchKeyword != null and searchKeyword != ''">
						AND ownr_nm = #{searchKeyword}
					</if>
				</when>
			</choose>
        </where>
    </select>
    
    <!-- 회원 상세 정보 조회 -->
    <select id="selectMbr" parameterType="HashMap" resultType="egovframework.theimc.login.vo.MbrVO">
        SELECT 
            mbr_sn,
            mbr_id as mbrId,
            mbr_pswd as mbrPswd,
            mbr_nm as mbrNm,
            mbr_role as mbrRole,
            ownr_nm as ownrNm
        FROM 
            svc_mbr_data
        WHERE 
            mbr_sn = #{sn}
            <!-- 권한별 운수회사 필터링 조건 (가장 먼저 적용) -->
	        <if test="dataFilter != null and dataFilter == 'self' and currentOwnrNm != null and currentOwnrNm != ''">
	            AND ownr_nm = #{currentOwnrNm}
	        </if>
    </select>
    	
	<!-- 회원 권한 수정 이력 -->
	<insert id="insertMbrRoleHstry" parameterType="HashMap">
        INSERT INTO svc_mbr_role_mdfcn_hstry (
        	mdfcn_mbr_id,
            mbr_id,
            mbr_role
        ) VALUES (
            #{currentUserId},
            #{mbrId},
            #{mbrRole}
        )
    </insert>
</mapper>