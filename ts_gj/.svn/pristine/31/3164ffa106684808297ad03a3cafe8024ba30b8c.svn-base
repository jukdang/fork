<!DOCTYPE html>
<html lang="ko" xmlns="http://www.w3.org/1999/xhtml" xmlns:th="https://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/thymeleaf-extras-springsecurity5">
<head>
	<th:block th:replace="/layout/head :: head"></th:block>
	<script th:src="@{/js/egovframework/paging.js}"></script>
	<script th:src="@{/js/egovframework/common.js}"></script>
</head>
<body>
	<!-- wrap : S -->
    <div class="wrap" id="wrap">
    
        <!-- 상단 헤더 -->
        <div th:replace="/layout/header :: top-menu"></div>
	        
	    <!-- container : S -->
		<div id="container" class="scrollBar">
		 	<!-- 메인 컨텐츠 -->
		    <div class="contents">
		    	<!-- 운행일지 메인 : S -->
		        <div class="wrapper">
	                <div class="filter_area wh_box">
						<div class="filter_box_wrap">
							<div class="filter_box">
				    			<!-- 소유자 선택 -->
                            	<div th:replace="/common/ownrSelect :: ownr-select"></div>
				    		</div>
							<div class="filter_box">
				    			<label>기간</label>
				    			<span class="date_range_box">
					    			<!-- 스크린 리더용 라벨 -->
								    <label for="startDate" class="sr-only">시작일</label>
									<input type="date" id="startDate">
									<em>~</em>
									<!-- 스크린 리더용 라벨 -->
									<label for="endDate" class="sr-only">종료일</label>
									<input type="date" id="endDate">
								</span>
				    		</div>
				    		<div class="filter_box">
				    			<label for="oprtrNm">운전원명</label>
								<input type="text" id="oprtrNm" placeholder="운전원명 입력">
				    		</div>
			    		</div>
			    		<button class="btn lg black btn_search" onclick="getDrivingLogList();">검색</button>
					</div>
					
					<div class="cont_section02">
						<div class="set_box type02">
							<!-- <button class="btn sm bd_red">삭제</button> -->
							<button class="btn mid white" onclick="drivingLogListDownload();">다운로드</button>
						</div>
						<div class="wh_box">
		            		<div class="tbl_box">
					    		<table class="tbl01">
					    			<thead>
										<tr>
											<th class="w8p"><input type="checkbox" id="checkAll"><label for="checkAll"></label></th>
											<th class="w14p">운수회사</th>
											<th class="w12p">운전원명</th>
											<th>운행 날짜</th>
											<th>승무 개시 시간</th>
											<th>승무 종료 시간</th>
											<th class="w12p">상세보기</th>
										</tr>
									</thead>
									<tbody  id="drivingLogList">
										<!-- <tr>
											<td><input type="checkbox"><label></label></td>
											<td>00운수</td>
											<td>홍길동</td>
											<td>06시 30분</td>
											<td>22시 00분</td>
											<td><button class="btn sm grey" th:onclick="'location.href=\'' + @{/operation/log} + '\';'">상세보기</button></td>
										</tr>
										<tr>
											<td><input type="checkbox"><label></label></td>
											<td>00운수</td>
											<td>홍길동</td>
											<td>06시 30분</td>
											<td>22시 00분</td>
											<td><button class="btn sm grey">상세보기</button></td>
										</tr> -->
									</tbody>
					    		</table>
					    	</div>
		            	</div>
	            	</div>
	            	<div class="paging" id="paging">
		    			<span class="num">
			    			<a href="#" class="first disable"><i class="fa fa-angle-double-left"></i></a>
			    			<a href="#" class="pre disable"><i class="fa fa-angle-left"></i></a>
			    			<span class="num">
				    			<a class="pageNoClass on">1</a>
				    			<a class="pageNoClass">2</a>
				    			<a class="pageNoClass">3</a>
				    			<a class="pageNoClass">4</a>
			    			</span>
			    			<a href="#" class="next disable"><i class="fa fa-angle-right"></i></a>
			    			<a href="#" class="last"><i class="fa fa-angle-double-right"></i></a>
		    			</span>
			    	</div>
	            </div>
	            <!-- 운행일지 메인 : E -->
	        </div>
	       
	    </div>
		<!-- container : E -->
		
		 <!-- 푸터 -->
		 <th:block th:replace="/layout/footer :: footer-simple"></th:block>
	</div>
	<!-- wrap : E -->
	
	<script>
	//defaultDate setting
	let defaultStartDate = dayjs().subtract(8, "day").format("YYYY-MM-DD");
	let defaultEndDate = dayjs().subtract(1, "day").format("YYYY-MM-DD");
	$("#startDate").val(defaultStartDate);
	$("#endDate").val(defaultEndDate);
	// $("#startDate").attr("max", defaultEndDate);
	$("#endDate").attr("max", defaultEndDate);
	
	$(function () {
		getDrivingLogList();
	})
	
	// 전체 선택/해제
	$(document).on('change', '#checkAll', function() {
	    const isChecked = $(this).is(':checked');
	    $('#drivingLogList input[type="checkbox"]').prop('checked', isChecked);
	});
	
	// 개별 체크박스 클릭 시 전체 선택 여부 동기화
	$(document).on('change', '#drivingLogList input[type="checkbox"]', function() {
	    const total = $('#drivingLogList input[type="checkbox"]').length;
	    const checked = $('#drivingLogList input[type="checkbox"]:checked').length;
	    $('#checkAll').prop('checked', total === checked);
	});
	
	//운행 일지 목록 조회
	function getDrivingLogList(pageIndex = 1) {
		
		$("#drivingLogList").empty();
		
		const params = {
			ownrNm: $("#ownrSelect").val(),
			startDate: $("#startDate").val(),
			endDate: $("#endDate").val(),
			oprtrNm: $("#oprtrNm").val(),
			pageIndex: pageIndex
	    };
		
	    customFetch({
	        url: '/operation/getDrivingLogList',
	        method: 'POST',
	        params: params,
	        loadingId: 'wrap',
	        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	        onSuccess: (response) => {
	//             console.log('getLogList 조회 성공:', response);
	            setDrivingLogList(response);
	        },
	        onError: (error) => console.error('에러 발생:', error)
	    });
	    
	}
	
	// 운행 일지 목록 조회 콜백함수
	function setDrivingLogList(response) {
		
		const $list = $('#drivingLogList');
		
		$list.empty();
		
		if(response.code == 200) {
			
			var html = '';
	        if (response && response.data && response.data.list) {
	            var data = response.data.list;
	            if(data.length > 0){
	            	
	            	for(const item of data){
	            		
	            		html += `<tr>
									<td><input type="checkbox" id="oprHstrySn_${item.oprHstrySn}" value="${item.oprHstrySn}"><label for="oprHstrySn_${item.oprHstrySn}"></label></td>
									<td>${ownrMasked(item.ownrNm)}</td>
									<td>${oprtrMasked(item.oprtrNm)}</td>
									<td>${item.oprYmd}</td>
									<td>${item.frstTm}</td>
									<td>${item.lastTm}</td>
									<td><button class="btn sm grey" onclick="goDetail('${item.oprHstrySn}');">상세보기</button></td>
								</tr>`;
	            		
	            	}
	            	$list.html(html);
	            	if (typeof setPagination === 'function') {
	                    setPagination('paging', 'getDrivingLogList', response.data.paginationInfo);
	                }
	            }else{
	            	html += `<tr>
		            	    	<td colspan="7">데이터가 없습니다.</td>
		            		</tr>`;
	            	$list.html(html);
	            	setPagination('paging', 'getDrivingLogList', response.data.paginationInfo);
	            }
	        }
	        
		}
		
	}
	
	//상세 페이지로 이동
	function goDetail(oprHstrySn) {
	    if (!oprHstrySn) {
	        console.warn('운행 일지 정보가 없습니다.');
	        return;
	    }
	    
	    // 상세 페이지로 이동 (실제 URL은 프로젝트에 맞게 수정)
	    window.location.href = contextPath + `/operation/drivingLog?oprHstrySn=${oprHstrySn}`;
	}
	
	//운행일지 다운로드
	function drivingLogListDownload() {
		
		const oprLstrySnList = $("#drivingLogList input[type=checkbox]:checked")
	    .map(function() {
	        return $(this).val();
	    })
	    .get();
		
		if(oprLstrySnList.length == 0) {
			alert("선택된 데이터가 없습니다.");
			return false;
		}
		
		try{
			customFetchJson('/operation/drivingLogListDownload', 
			    { oprLstrySnList: oprLstrySnList }, 
			    {
			        responseType: 'blob', // 이 옵션 추가 필요!
			        loadingId: 'container',
			        onSuccess: (blob) => {
		                // 이제 blob을 바로 사용 가능
		                const url = window.URL.createObjectURL(blob);
		                const a = document.createElement('a');
		                a.style.display = 'none';
		                a.href = url;
		                
		                const now = new Date();
		                const dateStr = now.getFullYear() + 
		                               String(now.getMonth() + 1).padStart(2, '0') + 
		                               String(now.getDate()).padStart(2, '0') + '_' +
		                               String(now.getHours()).padStart(2, '0') + 
		                               String(now.getMinutes()).padStart(2, '0') + 
		                               String(now.getSeconds()).padStart(2, '0');
		                
		                a.download = `운행일지_${dateStr}.xlsx`;
		                
		                document.body.appendChild(a);
		                a.click();
		                window.URL.revokeObjectURL(url);
		                document.body.removeChild(a);
			            
			        },
			        onError: (error) => {
			            console.error('GPS 조회 에러:', error);
			        }
			    }
			);
			
		} catch (error) {
		    console.error('다운로드 오류:', error);
		}
		
	}
	</script>
   
</body>

</html>