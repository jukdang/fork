<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
	<th:block th:replace="/layout/head :: head-admin"></th:block>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="text/javascript" th:src="@{/js/egovframework/setDefaultDate.js}"></script>
</head>
<body>
    <!-- 햄버거 메뉴 버튼 (모바일용) -->
    <!-- <button class="menu-toggle" onclick="toggleMenu()">☰ 메뉴</button> -->
    
    <!-- wrap : S -->
    <div class="wrap admin" id="wrap">
    
    <!-- 상단 메뉴 -->
    <th:block th:replace="/layout/header :: left-menu-admin"></th:block>
    
     <!-- container : S -->
		<div id="container" class="scrollBar">
    
		    <div class="contents">
		        <!-- 사이드 메뉴 -->
		       <!--  <aside class="aside-menu" id="asideMenu">
		            <div th:replace="layout/example_header :: asideMenu"></div>
		        </aside> -->
		        
		        <!-- 메인 컨텐츠 -->
		        <div class="wrapper">
		        	<div class="tit_wrap">
						<h1>이용현황통계</h1>
						<div class="top_right_area">
							<div class="top_date">
							    <span>기간</span>
							    <input type="date" id="startDate"> ~ 
							    <input type="date" id="endDate">
							    <button class="btn mcolor sm" onclick="searchData()">조회</button>
							</div>
							<a class="btn mid scolor">레포트 다운로드</a>
						</div>
					</div>
					<section>
						
						<div class="user_count">
						    <div class="wh_box" id="connUserCntBox">
						        <span><i class="fa-solid fa-user"></i></span>
						        <div><p>접속자 수</p> <div><strong id="connUserCnt">1,346</strong></div></div>
						    </div>
						    <div class="wh_box" id="concurrentUserBox">
						        <span><i class="fa-solid fa-user-group"></i></span>
						        <div><p>최대 동시 접속자 수</p> <div><strong id="concurrentUser">51</strong></div></div>
						    </div>
						    <div class="wh_box" id="newUserBox">
						        <span><i class="fa-solid fa-user-plus"></i></span>
						        <div><p>신규 회원 수</p> <div><strong>51</strong></div></div>
						    </div>
						</div>
						
						<div class="graph_area">
							<div class="wh_box">
								<div class="stit_wrap">
									<h2>일별 접속 통계</h2>
								</div>
								<div id="ConnUserChartDiv" style="width: 100%; height: 400px;"></div>
							</div>
							<div class="wh_box">
								<div class="stit_wrap">
									<h2>사용자별 접속 통계</h2>
								</div>
								<div style="width: 100%; height: 400px;"></div>
							</div>
						</div>
					</section>
		        </div>
		    </div>
	    
	    <!-- 푸터 -->
	    <th:block th:replace="/layout/footer :: footer-simple"></th:block>
	    </div>
		<!-- container : E -->
	</div>
	<!-- wrap : E -->
<script>
    $(document).ready(function() {
        createConnUserChart(); // 차트 초기 생성
        // 기본적으로 7일 전부터 오늘까지 설정
        setDateRange('startDate', 'endDate', 7);
        
        // 초기 데이터 로드
        searchData();
    });

    // 데이터 조회 함수
    function searchData() {
        const dateRange = getDateRange('startDate', 'endDate');
        if (!dateRange) return;
        
        console.log("조회 기간:", dateRange.startDate, "~", dateRange.endDate);
        
        // 접속자 수 데이터 가져오기
        connUserCnt(dateRange.startDate, dateRange.endDate);
        maxConcurrentUserCnt(dateRange.startDate, dateRange.endDate);
        
        // 그래프 렌더링 함수 호출
//      renderDailyChart();
//      renderUserChart();
    }

    // 접속자 수 통계
    function connUserCnt(startDate, endDate) {
        console.log(startDate, endDate);
        customFetch({
            url: '/mngr/stat/api/connUserCnt',
            method: 'POST',
            params: {
                startDate: startDate,
                endDate: endDate
            },
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            loadingId: 'connUserCntBox', // 로딩을 표시할 요소 ID
            onSuccess: function(response) {
                // 모든 connUserCnt 값의 합계 계산
                let totalConnUserCnt = 0;

                // response.data가 배열인지 확인
                if (response && response.data && Array.isArray(response.data)) {
                    response.data.forEach(function(item) {
                        // connUserCnt 값이 숫자인지 확인하고 더하기
                        if (item && item.connUserCnt !== undefined) {
                            totalConnUserCnt += parseInt(item.connUserCnt) || 0;
                        }
                    });
                }

                // 합계 표시
                $('#connUserCnt').text(totalConnUserCnt);

                // 디버깅용 로그
                console.log('원본 데이터:', response);
                console.log('계산된 합계:', totalConnUserCnt);
                
                // 그래프 생성 함수 호출
                updateConnUserChartData(response.data);
            },
            onError: function(error) {
                console.error('에러 발생:', error);
            }
        });
    }
    
 	// 최대 동시 접속자 수 통계
    function maxConcurrentUserCnt(startDate, endDate) {
        console.log(startDate, endDate);
        customFetch({
            url: '/mngr/stat/api/maxConcurrentUserCnt',
            method: 'POST',
            params: {
                startDate: startDate,
                endDate: endDate
            },
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            loadingId: 'concurrentUserBox', // 로딩을 표시할 요소 ID
            onSuccess: function(response) {
                // 최대값 찾기
                let maxValue = 0;

                // response.data가 배열인지 확인
                if (response && response.data && Array.isArray(response.data)) {
                    response.data.forEach(function(item) {
                        // maxConcurrentUserCnt 값이 숫자인지 확인하고 최대값 업데이트
                        if (item && item.maxConcurrentUsersCnt !== undefined) {
                            const value = parseInt(item.maxConcurrentUsersCnt) || 0;
                            if (value > maxValue) {
                                maxValue = value;
                            }
                        }
                    });
                }

                // 최대값 표시 (concurrentUserBox의 strong 태그에 표시)
                $('#concurrentUser').text(maxValue);

                // 디버깅용 로그
                console.log('원본 데이터:', response);
                console.log('최대 동시 접속자 수:', maxValue);
                
                // 필요한 경우 차트 데이터 업데이트
                updateMaxConcurrentUserChartData(response.data);
            },
            onError: function(error) {
                console.error('에러 발생:', error);
            }
        });
    }
    
    let connChartRoot = null;
    let connSeries = null;
    let connXAxis = null;
    let concurrentSeries = null;

    // amCharts 5를 사용한 그래프 생성 함수
    function createConnUserChart(containerId = "ConnUserChartDiv") {
        am5.ready(function () {
            // 중복 제거
            am5.array.each(am5.registry.rootElements, function (root) {
                if (root.dom.id === containerId) {
                    root.dispose();
                }
            });

            connChartRoot = am5.Root.new(containerId);

            connChartRoot.setThemes([am5themes_Animated.new(connChartRoot)]);

            const chart = connChartRoot.container.children.push(
                am5xy.XYChart.new(connChartRoot, {
                    layout: connChartRoot.verticalLayout,
                    panX: true,
                    panY: true,
                    wheelX: "panX",
                    wheelY: "zoomX"
                })
            );

            // X축: DateAxis로 변경
            connXAxis = chart.xAxes.push(
                am5xy.DateAxis.new(connChartRoot, {
                    baseInterval: { timeUnit: "day", count: 1 },
                    markUnitChange: false,  // ✅ 월 단위 강조 제거
                    renderer: am5xy.AxisRendererX.new(connChartRoot, {
                        minGridDistance: 10,
                        stroke: am5.color(0x999999),
                        strokeOpacity: 1,
                        strokeWidth: 1
                    }),
                })
            );
            
            connXAxis.get("dateFormats")["day"] = "MM/dd";
            
            connXAxis.get("renderer").labels.template.setAll({
                fontSize: 12,
                fill: am5.color(0x666666),
                paddingTop: 10,
            });

            // X축 틱 표시
            connXAxis.get("renderer").ticks.template.setAll({
                visible: true,
                stroke: am5.color(0x999999),
                strokeWidth: 1,
                length: 6
            });

            // X축 그리드 점선 설정
            connXAxis.get("renderer").grid.template.setAll({
                location: 0.5,
                strokeDasharray: [2, 4],
                stroke: am5.color(0xcccccc),
                strokeOpacity: 0.5
            });

            // Y축
            const yAxis = chart.yAxes.push(
                am5xy.ValueAxis.new(connChartRoot, {
                    renderer: am5xy.AxisRendererY.new(connChartRoot, {
                        stroke: am5.color(0x999999),
                        strokeOpacity: 1,
                        strokeWidth: 1
                    })
                })
            );

            yAxis.get("renderer").labels.template.setAll({
                fontSize: 12,
                fill: am5.color(0x666666),
                paddingRight: 10
            });

            // Y축 그리드 점선 설정
            yAxis.get("renderer").grid.template.setAll({
                strokeDasharray: [2, 4],
                stroke: am5.color(0xcccccc),
                strokeOpacity: 0.5
            });
            
            yAxis.get("renderer").ticks.template.setAll({
                visible: true,
                stroke: am5.color(0x999999),
                strokeWidth: 1,
                length: 6
            });
            
            // 시리즈 생성 - DateAxis는 valueXField를 사용
            connSeries = chart.series.push(
                am5xy.LineSeries.new(connChartRoot, {
                    name: "접속자 수",
                    xAxis: connXAxis,
                    yAxis: yAxis,
                    valueYField: "connUserCnt",
                    valueXField: "date", // date 필드를 사용
                    tooltip: am5.Tooltip.new(connChartRoot, {
                        labelText: "{valueX.formatDate('MM/dd')} - {valueY}"
                    }),
                    stroke: am5.color(0x6a81ff),
                    fill: am5.color(0x6a81ff)
                })
            );

            // 원형 점 불릿 추가
            connSeries.bullets.push(function () {
                return am5.Bullet.new(connChartRoot, {
                    sprite: am5.Circle.new(connChartRoot, {
                        radius: 4,
                        fill: connSeries.get("stroke")
                    })
                });
            });

         	// 시리즈 생성 - DateAxis는 valueXField를 사용
            concurrentSeries = chart.series.push(
                am5xy.LineSeries.new(connChartRoot, {
                    name: "최대 동시 접속자 수",
                    xAxis: connXAxis,
                    yAxis: yAxis,
                    valueYField: "maxConcurrentUsersCnt",
                    valueXField: "date", // date 필드를 사용
                    tooltip: am5.Tooltip.new(connChartRoot, {
                        labelText: "{valueX.formatDate('MM/dd')} - {valueY}"
                    }),
                    stroke: am5.color(0x4CAF50),
                    fill: am5.color(0x4CAF50)
                })
            );

            // 원형 점 불릿 추가
            concurrentSeries.bullets.push(function () {
                return am5.Bullet.new(connChartRoot, {
                    sprite: am5.Circle.new(connChartRoot, {
                        radius: 4,
                        fill: concurrentSeries.get("stroke")
                    })
                });
            });
            
            const cursor = chart.set("cursor", am5xy.XYCursor.new(connChartRoot, {
                behavior: "none",
                xAxis: connXAxis,
                yAxis: yAxis
            }));
            
            cursor.lineY.set("visible", false);
            cursor.lineX.set("visible", true);
            
         // 범례 생성 - 차트 위에 추가
            const legend = chart.children.push(
                am5.Legend.new(connChartRoot, {
                    centerX: am5.p50,
                    x: am5.p50,
                    layout: connChartRoot.horizontalLayout,
                    marginTop: 0,
                    marginBottom: 15
                })
            );
            
            // 범례 폰트 크기 및 투명도 설정
            legend.labels.template.setAll({
                fontSize: 14,
            });
            
         	// 범례에 시리즈 추가 (중요!)
            legend.data.setAll(chart.series.values);
            
            chart.appear(1000, 100);
        });
    }

    // 데이터 업데이트 함수 변경
    function updateConnUserChartData(newData) {
        if (connSeries && connXAxis) {
            // 날짜 문자열을 Date 객체로 변환
            const processedData = newData.map(item => {
                return {
                    date: new Date(item.connDate).getTime(), // 타임스탬프로 변환
                    connUserCnt: item.connUserCnt
                };
            });
            
            // 데이터 정렬 (선택적)
            processedData.sort((a, b) => a.date - b.date);
            
            // 차트 데이터 설정
            connSeries.data.setAll(processedData);
        } else {
            console.warn("차트가 아직 생성되지 않았습니다.");
        }
    }
    
 	// 데이터 업데이트 함수 변경
    function updateMaxConcurrentUserChartData(newData) {
 		console.log(newData)
	    if (concurrentSeries && connXAxis) {
	        // 날짜 문자열을 Date 객체로 변환
	        const processedData = newData.map(item => {
	            return {
	                date: new Date(item.date).getTime(), // 문제: item.date를 사용해야 함
	                maxConcurrentUsersCnt: item.maxConcurrentUsersCnt
	            };
	        });
	        
	        // 데이터 정렬 (선택적)
	        processedData.sort((a, b) => a.date - b.date);
	        
	        // 차트 데이터 설정
		    console.log(processedData)
	        concurrentSeries.data.setAll(processedData);
	    } else {
	        console.warn("차트가 아직 생성되지 않았습니다.");
	    }
	}
</script>

</body>
</html>
