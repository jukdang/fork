	<!-- 	진단 내역 - 상세 고장코드 조회 -->
	<select id="selectDiagnosisHistBkdnResult" resultType="egovMap">
    	SELECT  
			avbh.sys_nm
			, avbh.logger_cd
			, avbh.dtc
			, avbh.ocrn_dt
			, cvbi.msg_cn
		FROM anls_vhcl_bkdn_hstry avbh
		LEFT JOIN cmm_vhcl_bkdn_info cvbi 
			ON avbh.sys_nm = cvbi.sys_nm 
<!-- 				AND avbh.logger_cd = cvbi.logger_cd -->
				AND avbh.dtc = cvbi.dtc
		WHERE vhcl_sn = #{vhclSn}
    	<![CDATA[
	    	AND ocrn_dt >= CONCAT(#{startDt}, ' 00:00:00')
	      	AND ocrn_dt <= CONCAT(#{endDt}, ' 23:59:59') 
	      	]]> 
	</select>
	
	<!-- 	진단 내역 - 상세 점검이력 조회 -->
	<select id="selectDiagnosisHistChckResult" resultType="egovMap">
		SELECT 
		    avch.chck_cd
		    , IFNULL(cvci.chck_nm, '-') as chck_nm
		    , avch.chck_stts
		    , avch.bgng_dt
		    , avch.end_dt
		    , avch.opr_dstnc
		    , cvci.msg_cn
   		    , GROUP_CONCAT(IFNULL(cvsi.snsr_cd, cvsci.snsr_cd) ORDER BY cvsci.vw_rnk SEPARATOR ',') AS snsr_cd_list
		    , GROUP_CONCAT(IFNULL(cvsi.snsr_nm, cvsci.snsr_cd) ORDER BY cvsci.vw_rnk SEPARATOR ',') AS snsr_nm_list 
		FROM anls_vhcl_chck_hstry avch
		LEFT JOIN cmm_vhcl_info cvi ON avch.vhcl_sn = cvi.vhcl_sn
		LEFT JOIN cmm_vhcl_chck_info cvci ON avch.chck_cd = cvci.chck_cd
		LEFT JOIN cmm_vhcl_snsr_chck_info cvsci ON cvci.chck_nm = cvsci.chck_nm AND cvi.vhcl_type = cvsci.vhcl_type
		LEFT JOIN cmm_vhcl_snsr_info cvsi ON cvsci.snsr_cd = cvsi.snsr_cd
		WHERE avch.vhcl_sn = #{vhclSn}
    	<![CDATA[
	    	AND end_dt >= CONCAT(#{startDt}, ' 00:00:00')
	      	AND end_dt <= CONCAT(#{endDt}, ' 23:59:59') 
	      	]]> 
		GROUP BY 
		    avch.chck_cd
		  , cvci.chck_nm
		  , avch.chck_stts
		  , avch.bgng_dt
		  , avch.end_dt
		  , avch.opr_dstnc
		  , cvci.msg_cn
		  , cvsci.vhcl_type
	</select>
</mapper>