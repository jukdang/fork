<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.theimc.rfid.service.impl.RfidDataMapper">

    <!-- RFID 운행 데이터 저장 -->
    <insert id="insertRfidData" parameterType="egovframework.theimc.rfid.vo.RfidDataVO">
        INSERT INTO svc_opr_rfid_data (
            mt_id,
            rfid_no,
            tag_dt,
            reg_dt
        ) VALUES (
            #{mtId},
            #{rfidNo},
            #{tagDt},
            NOW()
        )
    </insert>
    
    <!-- RFID 운행 데이터 목록 조회 -->
    <select id="selectRfidDataList" parameterType="HashMap" resultType="egovframework.theimc.rfid.vo.RfidDataVO">
        SELECT 
            mt_id as mtId,
            rfid_no as rfidNo,
            tag_dt as tagDt,
            reg_dt as regDt
        FROM 
            svc_opr_rfid_data
        <where>
            <choose>
                <when test="searchType == 'mtId'">
                    <if test="searchKeyword != null and searchKeyword != ''">
                        AND mt_id LIKE CONCAT('%', #{searchKeyword}, '%')
                    </if>
                </when>
                <when test="searchType == 'rfidNo'">
                    <if test="searchKeyword != null and searchKeyword != ''">
                        AND rfid_no LIKE CONCAT('%', #{searchKeyword}, '%')
                    </if>
                </when>
            </choose>
            <if test="startDate != null and startDate != ''">
                <![CDATA[
                AND DATE(tag_dt) >= #{startDate}
                ]]>
            </if>
            <if test="endDate != null and endDate != ''">
                <![CDATA[
                AND DATE(tag_dt) <= #{endDate}
                ]]>
            </if>
        </where>
        ORDER BY 
            reg_dt DESC
        LIMIT #{firstRecordIndex}, #{recordCountPerPage}
    </select>
    
    <!-- 전체 RFID 운행 데이터 수 조회 -->
    <select id="selectRfidDataTotalCnt" parameterType="HashMap" resultType="int">
        SELECT 
            COUNT(*)
        FROM 
            svc_opr_rfid_data
        <where>
            <if test="searchKeyword != null and searchKeyword != ''">
                <choose>
                    <when test="searchType == 'mtId'">
                        AND mt_id LIKE CONCAT('%', #{searchKeyword}, '%')
                    </when>
                    <when test="searchType == 'rfidNo'">
                        AND rfid_no LIKE CONCAT('%', #{searchKeyword}, '%')
                    </when>
                </choose>
            </if>
            <if test="startDate != null and startDate != ''">
                <![CDATA[AND DATE(tag_dt) >= #{startDate}]]>
            </if>
            <if test="endDate != null and endDate != ''">
                <![CDATA[AND DATE(tag_dt) <= #{endDate}]]>
            </if>
        </where>
    </select>
    
    <!-- MT_ID로 RFID 데이터 조회 -->
    <select id="selectByMtId" parameterType="string" resultType="egovframework.theimc.rfid.vo.RfidDataVO">
        SELECT 
            mt_id as mtId,
            rfid_no as rfidNo,
            tag_dt as tagDt,
            reg_dt as regDt
        FROM 
            svc_opr_rfid_data 
        WHERE 
            mt_id = #{mtId}
        ORDER BY 
            reg_dt DESC
        LIMIT 100
    </select>
    
    <!-- RFID 번호로 최근 데이터 조회 -->
    <select id="selectByRfidNo" parameterType="string" resultType="egovframework.theimc.rfid.vo.RfidDataVO">
        SELECT 
            mt_id as mtId,
            rfid_no as rfidNo,
            tag_dt as tagDt,
            reg_dt as regDt
        FROM 
            svc_opr_rfid_data 
        WHERE 
            rfid_no = #{rfidNo}
        ORDER BY 
            reg_dt DESC
        LIMIT 10
    </select>

</mapper>